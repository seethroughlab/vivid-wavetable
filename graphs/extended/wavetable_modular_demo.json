{
  "nodes": {
    "clock1": {
      "type": "Clock",
      "params": { "bpm": 120.0 }
    },
    "cp1": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0, "degree_1": 2, "degree_2": 4, "degree_3": 5,
        "voicing_0": 1, "voicing_1": 1, "voicing_2": 1, "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": { "name": "vivid-wavetable" },
      "params": { "max_voices": 8, "portamento": 0.0 }
    },
    "amp_env": {
      "type": "SpreadADSR",
      "params": { "attack": 0.01, "decay": 0.3, "sustain": 0.7, "release": 0.5 }
    },
    "filt_env": {
      "type": "SpreadADSR",
      "params": { "attack": 0.01, "decay": 0.5, "sustain": 0.2, "release": 0.4 }
    },
    "osc_a": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "wavetable": 3,
        "position": 0.3,
        "amplitude": 0.25,
        "warp_mode": 1,
        "warp_amount": 0.2,
        "unison_voices": 4,
        "unison_spread": 25.0,
        "unison_stereo": 0.8
      }
    },
    "osc_b": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "wavetable": 7,
        "position": 0.6,
        "amplitude": 0.2,
        "warp_mode": 5,
        "warp_amount": 0.3,
        "unison_voices": 2,
        "unison_spread": 15.0
      }
    },
    "filter_a": {
      "type": "PolyFilter",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "filter_type": 1,
        "filter_cutoff": 3000.0,
        "filter_resonance": 0.3,
        "filter_keytrack": 0.5
      }
    },
    "filter_b": {
      "type": "PolyFilter",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "filter_type": 6,
        "filter_cutoff": 5000.0,
        "filter_resonance": 0.15
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": { "stereo_spread": 0.7, "vel_to_volume": 0.8 }
    },
    "reverb1": {
      "type": "Reverb",
      "params": { "room_size": 0.7, "mix": 0.3 }
    },
    "gain1": {
      "type": "Gain",
      "params": { "gain": 0.8 }
    },
    "out1": { "type": "audio_out" }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "cp1/beat_phase" },
    { "from": "cp1/notes",         "to": "voices/notes_in" },
    { "from": "cp1/velocities",    "to": "voices/velocities_in" },
    { "from": "cp1/gates",         "to": "voices/gates_in" },

    { "from": "voices/gates",       "to": "amp_env/gates" },
    { "from": "voices/gates",       "to": "filt_env/gates" },
    { "from": "voices/frequencies",  "to": "osc_a/frequencies" },
    { "from": "voices/frequencies",  "to": "osc_b/frequencies" },
    { "from": "voices/gates",       "to": "osc_a/gates" },
    { "from": "voices/gates",       "to": "osc_b/gates" },
    { "from": "voices/velocities",  "to": "osc_a/velocities" },
    { "from": "voices/velocities",  "to": "osc_b/velocities" },

    { "from": "osc_a/output",        "to": "filter_a/input" },
    { "from": "osc_b/output",        "to": "filter_b/input" },
    { "from": "voices/frequencies",   "to": "filter_a/frequencies" },
    { "from": "voices/frequencies",   "to": "filter_b/frequencies" },
    { "from": "voices/gates",        "to": "filter_a/gates" },
    { "from": "voices/gates",        "to": "filter_b/gates" },
    { "from": "filt_env/envelopes",  "to": "filter_a/cutoff_mod" },
    { "from": "filt_env/envelopes",  "to": "filter_b/cutoff_mod" },

    { "from": "filter_a/output",     "to": "mixer/input" },
    { "from": "amp_env/envelopes",   "to": "mixer/amp_env" },
    { "from": "voices/velocities",   "to": "mixer/velocities" },

    { "from": "mixer/output",       "to": "reverb1/input" },
    { "from": "reverb1/output",     "to": "gain1/input" },
    { "from": "gain1/output",       "to": "out1/input" }
  ]
}
