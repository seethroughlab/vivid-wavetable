{
  "meta": {
    "id": "texture_tide_bed",
    "title": "Texture Tide Bed",
    "description": "This patch should sound like a rolling texture bed with tide-like motion, soft harmonic churn, and enough sustain to sit behind a cue without taking over. It is built from a wavetable voice.",
    "tags": [
      "pad",
      "texture",
      "wavetable",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 24,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 72.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 9,
        "mode": 1,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 3,
        "degree_3": 6,
        "voicing_0": 2,
        "voicing_1": 1,
        "voicing_2": 2,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 1.2,
        "decay": 0.9,
        "sustain": 0.68,
        "release": 2.0,
        "amplitude": 0.26
      }
    },
    "pos_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.025,
        "depth": 0.36,
        "shape": 0
      }
    },
    "warp_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.045,
        "depth": 0.22,
        "shape": 1
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 4,
        "position": 0.36,
        "amplitude": 0.18,
        "warp_mode": 6,
        "warp_amount": 0.12,
        "position_smooth_ms": 24.0,
        "warp_smooth_ms": 22.0,
        "phase_reset_mode": 2,
        "phase_random": 0.45,
        "stereo_phase_offset": 0.38,
        "drift_amount": 0.62,
        "drift_rate_hz": 0.11,
        "unison_voices": 3,
        "unison_spread": 14.0,
        "unison_stereo": 0.45,
        "detune": 2.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.84,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "pos_lfo/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "warp_lfo/value",
      "to": "wt/warp_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    }
  ]
}
