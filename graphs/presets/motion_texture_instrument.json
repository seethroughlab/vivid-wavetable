{
  "meta": {
    "id": "motion_texture_instrument",
    "title": "Motion Texture",
    "description": "Playable WavetableLayer motion texture instrument with LFO-driven position and warp modulation.",
    "tags": [
      "texture",
      "wavetable",
      "motion",
      "instrument",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 305,
    "requires_packages": [
      "vivid-wavetable"
    ],
    "content_kind": "instrument",
    "category": "Texture",
    "family": "Motion",
    "role": "utility",
    "playability": "midi",
    "preview_controls": [
      {
        "node": "pos_lfo",
        "param": "depth",
        "label": "Motion"
      },
      {
        "node": "wt",
        "param": "position",
        "label": "Tone"
      },
      {
        "node": "reverb",
        "param": "mix",
        "label": "Output"
      }
    ]
  },
  "nodes": {
    "midi": {
      "type": "MidiInput",
      "params": {}
    },
    "voices": {
      "type": "VoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 5
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 1.2,
        "decay": 0.9,
        "sustain": 0.68,
        "release": 2.0,
        "amplitude": 0.26
      }
    },
    "pos_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.025,
        "depth": 0.36,
        "shape": 0
      }
    },
    "warp_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.045,
        "depth": 0.22,
        "shape": 1
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 1,
        "wav_file": "assets/wavetables/texture-tide.wav",
        "position": 0.36,
        "amplitude": 0.18,
        "warp_mode": 6,
        "warp_amount": 0.12,
        "position_smooth_ms": 24.0,
        "warp_smooth_ms": 22.0,
        "phase_reset_mode": 2,
        "phase_random": 0.45,
        "stereo_phase_offset": 0.38,
        "drift_amount": 0.62,
        "drift_rate_hz": 0.11,
        "unison_voices": 3,
        "unison_spread": 14.0,
        "unison_stereo": 0.45,
        "detune": 2.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.84,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "midi/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "midi/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "midi/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/frequencies",
      "to": "wt/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "wt/gates"
    },
    {
      "from": "voices/velocities",
      "to": "wt/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "wt/lane_ids"
    },
    {
      "from": "pos_lfo/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "warp_lfo/value",
      "to": "wt/warp_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    }
  ]
}
