{
  "meta": {
    "id": "dual_filter_split",
    "title": "Dual Filter Split",
    "description": "This patch should sound like a dual-layer texture with evolving timbre, spacious bloom, and layered atmosphere. It is built from a wavetable voice.",
    "tags": [
      "texture",
      "wavetable",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "advanced",
    "featured_rank": 118,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.3,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.0
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.3,
        "decay": 0.8,
        "sustain": 0.3,
        "release": 1.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.25,
        "unison_voices": 8,
        "unison_spread": 35.0,
        "unison_stereo": 0.9,
        "unison_spread_mode": 1,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 2
      }
    },
    "filt_a": {
      "type": "Filter",
      "params": {
        "mode": 6,
        "cutoff": 2000.0,
        "resonance": 0.3
      }
    },
    "filt_b": {
      "type": "Filter",
      "params": {
        "mode": 7,
        "cutoff": 3000.0,
        "resonance": 0.4
      }
    },
    "mix_a": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "mix_b": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 0.7,
        "gain_2": 0.5
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.7,
        "mix": 0.35
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filt_a/input"
    },
    {
      "from": "osc/output",
      "to": "filt_b/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filt_a/frequencies"
    },
    {
      "from": "voices/frequencies",
      "to": "filt_b/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filt_a/cutoff_mod"
    },
    {
      "from": "filt_env/value",
      "to": "filt_b/cutoff_mod"
    },
    {
      "from": "filt_a/output",
      "to": "mix_a/input"
    },
    {
      "from": "filt_b/output",
      "to": "mix_b/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_a/amp_env_audio"
    },
    {
      "from": "amp_env/value",
      "to": "mix_b/amp_env_audio"
    },
    {
      "from": "mix_a/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_b/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
