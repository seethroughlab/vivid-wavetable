{
  "meta": {
    "id": "warm_dual_pad",
    "title": "Warm Dual Pad",
    "description": "This patch should sound like a warm, dual-layer sustained pad with soft motion and wide stereo bloom. Both oscillator layers are pre-mixed and shaped through a single DualFilter for a unified body.",
    "tags": [
      "pad",
      "wavetable",
      "hybrid",
      "subtractive",
      "demo",
      "polyphonic",
      "dual-filter"
    ],
    "difficulty": "intermediate",
    "featured_rank": 162,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.8,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 1.0,
        "decay": 0.8,
        "sustain": 0.3,
        "release": 1.5
      }
    },
    "osc_a": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.3,
        "amplitude": 0.25,
        "unison_voices": 4,
        "unison_spread": 30.0,
        "unison_stereo": 0.8,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "osc_b": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 1,
        "amplitude": 0.2,
        "detune": 8.0
      }
    },
    "pre_sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.82
      }
    },
    "dual_filter": {
      "type": "DualFilter",
      "params": {
        "routing": 0,
        "a_mode": 1,
        "a_cutoff": 2800.0,
        "a_resonance": 0.15,
        "a_drive": 0.04,
        "a_keytrack": 0.35,
        "b_mode": 0,
        "b_cutoff": 6500.0,
        "b_resonance": 0.06,
        "b_drive": 0.0,
        "b_keytrack": 0.15,
        "output_gain": 1.0
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.3,
        "depth": 0.4,
        "voices": 3,
        "mix": 0.3
      }
    },
    "mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.75,
        "mix": 0.35
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "filt_env/value",
      "to": "dual_filter/a_cutoff_mod"
    },
    {
      "from": "dual_filter/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "mix/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix/amp_env_audio"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "osc_a/voice_gain_audio"
    },
    {
      "from": "osc_b/output",
      "to": "dual_filter/input"
    },
    {
      "from": "osc_a/output",
      "to": "pre_sum/input_1"
    },
    {
      "from": "mix/output",
      "to": "pre_sum/input_2"
    },
    {
      "from": "pre_sum/output",
      "to": "reverb/input"
    },
    {
      "from": "chords/notes_out",
      "to": "osc_a/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "osc_b/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "dual_filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "mix/velocities"
    }
  ]
}
