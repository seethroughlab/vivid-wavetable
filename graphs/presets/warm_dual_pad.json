{
  "meta": {
    "id": "warm_dual_pad",
    "title": "Warm Dual Pad",
    "description": "This patch should sound like a warm, dual-layer sustained pad with soft motion and wide stereo bloom. It is built from a wavetable/analog hybrid voice.",
    "tags": [
      "pad",
      "wavetable",
      "hybrid",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 162,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.8,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 1.0,
        "decay": 0.8,
        "sustain": 0.3,
        "release": 1.5
      }
    },
    "osc_a": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.3,
        "amplitude": 0.25,
        "unison_voices": 4,
        "unison_spread": 30.0,
        "unison_stereo": 0.8,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "osc_b": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 1,
        "amplitude": 0.2,
        "detune": 8.0
      }
    },
    "filt_a": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 3000.0,
        "resonance": 0.15
      }
    },
    "filt_b": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 5000.0,
        "resonance": 0.1
      }
    },
    "chorus_a": {
      "type": "Chorus",
      "params": {
        "rate": 0.3,
        "depth": 0.4,
        "voices": 3,
        "mix": 0.3
      }
    },
    "chorus_b": {
      "type": "Chorus",
      "params": {
        "rate": 0.35,
        "depth": 0.35,
        "voices": 3,
        "mix": 0.3
      }
    },
    "mix_a": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "mix_b": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.75,
        "mix": 0.35
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc_a/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc_a/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc_a/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "osc_b/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc_b/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc_b/velocities"
    },
    {
      "from": "osc_a/output",
      "to": "filt_a/input"
    },
    {
      "from": "osc_b/output",
      "to": "filt_b/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filt_a/frequencies"
    },
    {
      "from": "voices/frequencies",
      "to": "filt_b/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filt_a/cutoff_mod"
    },
    {
      "from": "filt_env/value",
      "to": "filt_b/cutoff_mod"
    },
    {
      "from": "filt_a/output",
      "to": "chorus_a/input"
    },
    {
      "from": "filt_b/output",
      "to": "chorus_b/input"
    },
    {
      "from": "chorus_a/output",
      "to": "mix_a/input"
    },
    {
      "from": "chorus_b/output",
      "to": "mix_b/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_a/amp_env_audio"
    },
    {
      "from": "amp_env/value",
      "to": "mix_b/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mix_a/velocities"
    },
    {
      "from": "voices/velocities",
      "to": "mix_b/velocities"
    },
    {
      "from": "mix_a/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_b/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc_a/lane_ids"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc_b/lane_ids"
    }
  ]
}
