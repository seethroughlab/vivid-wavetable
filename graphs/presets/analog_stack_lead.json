{
  "meta": {
    "id": "analog_stack_lead",
    "title": "Analog Stack Lead",
    "description": "This patch should sound like a forward analog-led stack with clear attacks, a strong center voice, and sub support underneath. The drive should thicken the lead body without turning it into harsh distortion.",
