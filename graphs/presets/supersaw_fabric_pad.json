{
  "meta": {
    "id": "supersaw_fabric_pad",
    "title": "Supersaw Fabric Pad",
    "description": "This patch should sound like a supersaw-style sustained pad with soft motion and wide stereo bloom. It is built from a wavetable voice.",
    "tags": [
      "pad",
      "wavetable",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 154,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 96.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 2,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 3,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 2,
        "voicing_1": 2,
        "voicing_2": 1,
        "voicing_3": 2
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.3,
        "decay": 0.32,
        "sustain": 0.92,
        "release": 1.2,
        "amplitude": 0.34
      }
    },
    "drift_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.03,
        "depth": 0.08,
        "shape": 0
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 1,
        "position": 0.28,
        "amplitude": 0.18,
        "position_smooth_ms": 12.0,
        "warp_smooth_ms": 12.0,
        "phase_reset_mode": 0,
        "start_phase": 0.02,
        "stereo_phase_offset": 0.28,
        "drift_amount": 0.2,
        "drift_rate_hz": 0.1,
        "unison_voices": 5,
        "unison_spread": 18.0,
        "unison_stereo": 0.55,
        "detune": 3.5
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.11,
        "depth": 0.16,
        "voices": 3,
        "mix": 0.1
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.68,
        "mix": 0.14
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "drift_lfo/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    }
  ]
}
