{
  "meta": {
    "id": "hybrid_keys_instrument",
    "title": "Hybrid Keys",
    "description": "Playable Layer-based hybrid keys instrument combining a WavetableLayer body and an analog support layer through a dual-stage tone stack.",
    "tags": ["keys", "wavetable", "hybrid", "instrument", "polyphonic"],
    "difficulty": "beginner",
    "featured_rank": 300,
    "requires_packages": ["vivid-wavetable"],
    "content_kind": "instrument",
    "category": "Keys",
    "family": "Hybrid",
    "role": "reference",
    "playability": "midi",
    "preview_controls": [
      { "node": "instrument", "param": "filter_cutoff", "label": "Brightness" },
      { "node": "instrument", "param": "drive", "label": "Body" },
      { "node": "instrument", "param": "output_level", "label": "Output" }
    ]
  },
  "nodes": {
    "midi": {
      "type": "MidiInput",
      "params": {}
    },
    "instrument": {
      "type": "HybridKeys",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "wavetable_source": 1,
        "wavetable_file": "assets/wavetables/warm-keys-core.wav",
        "wavetable_position": 0.28,
        "analog_blend": 0.68,
        "filter_cutoff": 3600.0,
        "filter_resonance": 0.18,
        "amp_attack": 0.01,
        "amp_release": 0.4,
        "drive": 0.14,
        "output_level": 0.9
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    { "from": "midi/notes", "to": "instrument/notes" },
    { "from": "midi/velocities", "to": "instrument/velocities" },
    { "from": "midi/gates", "to": "instrument/gates" },
    { "from": "instrument/output", "to": "out/input" }
  ]
}
