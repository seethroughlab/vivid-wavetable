{
  "nodes": {
    "clock": {
      "type": "clock_au",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "chord_progression_au",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "envelope_au",
      "params": {
        "attack": 0.005,
        "decay": 0.2,
        "sustain": 0.9,
        "release": 0.15
      }
    },
    "filt_env": {
      "type": "envelope_au",
      "params": {
        "attack": 0.005,
        "decay": 0.3,
        "sustain": 0.3,
        "release": 0.15
      }
    },
    "osc": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 2,
        "amplitude": 0.35
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.6,
        "octave": 0,
        "waveform": 3
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 6,
        "cutoff": 800.0,
        "resonance": 0.35,
        "drive": 0.2
      }
    },
    "dist": {
      "type": "Distortion",
      "params": {
        "drive": 2.0,
        "tone": 0.4,
        "level": 0.8,
        "mix": 0.5
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "sub_mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0
      }
    },
    "comp": {
      "type": "Compressor",
      "params": {
        "threshold": -15.0,
        "ratio": 4.0,
        "attack": 5.0,
        "release": 50.0
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "sub/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "sub/gates"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "dist/input"
    },
    {
      "from": "dist/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "sub/output",
      "to": "sub_mix/input"
    },
    {
      "from": "amp_env/value",
      "to": "sub_mix/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "sub_mix/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "comp/input"
    },
    {
      "from": "comp/output",
      "to": "out/input"
    },
    {
      "from": "clock/beat_phase",
      "to": "amp_env/beat_phase"
    },
    {
      "from": "clock/beat_phase",
      "to": "filt_env/beat_phase"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    },
    {
      "from": "voices/lane_ids",
      "to": "sub/lane_ids"
    }
  ]
}
