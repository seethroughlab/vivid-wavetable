{
  "nodes": {
    "clock": {
      "type": "clock_au",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "chord_progression_au",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "envelope_au",
      "params": {
        "attack": 0.01,
        "decay": 0.3,
        "sustain": 0.6,
        "release": 0.4
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 0,
        "position": 0.2,
        "amplitude": 0.3
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 5000.0,
        "resonance": 0.15
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.4
      }
    },
    "flanger": {
      "type": "Flanger",
      "params": {
        "rate": 0.3,
        "depth": 0.6,
        "feedback": 0.5,
        "mix": 0.4
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.25
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "flanger/input"
    },
    {
      "from": "flanger/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "clock/beat_phase",
      "to": "amp_env/beat_phase"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
