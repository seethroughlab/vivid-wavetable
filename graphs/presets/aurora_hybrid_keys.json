{
  "meta": {
    "id": "aurora_hybrid_keys",
    "title": "Aurora Hybrid Keys",
    "description": "This patch should sound like a shimmering, hybrid keys patch with defined attacks, musical sustain, and clear harmonic body. It is built from a wavetable/analog hybrid voice.",
    "tags": [
      "keys",
      "wavetable",
      "hybrid",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 107,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 104.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 0,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 3,
        "degree_3": 4,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 2,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.02,
        "decay": 0.18,
        "sustain": 0.7,
        "release": 0.35
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.28,
        "amplitude": 0.24,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 5,
        "unison_spread": 24.0,
        "unison_stereo": 0.95,
        "detune": 5.0,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 0
      }
    },
    "analog": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 3,
        "amplitude": 0.13,
        "detune": 3.0
      }
    },
    "mix_analog": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.45
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.7
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.24,
        "depth": 0.32,
        "voices": 3,
        "mix": 0.24
      }
    },
    "delay": {
      "type": "Delay",
      "params": {
        "time": 0.24,
        "feedback": 0.22,
        "mix": 0.14
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.62,
        "mix": 0.22
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "analog/voices_out",
      "to": "mix_analog/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_analog/amp_env_audio"
    },
    {
      "from": "wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_analog/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "delay/input"
    },
    {
      "from": "delay/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "analog/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    }
  ]
}
