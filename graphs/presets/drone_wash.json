{
  "meta": {
    "id": "drone_wash",
    "title": "Drone Wash",
    "description": "This patch should sound like a drone with long sustain, slow movement, and immersive weight. It is built from a wavetable voice. A per-note air layer adds breath and transient detail.",
    "tags": [
      "drone",
      "wavetable",
      "hybrid",
      "noise-layer",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 117,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 2.0,
        "decay": 1.0,
        "sustain": 0.7,
        "release": 3.0
      }
    },
    "osc_a": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.2,
        "unison_voices": 8,
        "unison_spread": 50.0,
        "unison_stereo": 1.0,
        "unison_spread_mode": 2,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 0
      }
    },
    "osc_b": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.6,
        "amplitude": 0.15,
        "unison_voices": 4,
        "unison_spread": 25.0,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "noise": {
      "type": "NoiseLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "color": 1,
        "level": 0.07,
        "tone": 0.58,
        "tone_tracking": 0.14,
        "attack_burst": 0.06,
        "attack_decay_ms": 52.0,
        "velocity_to_level": 0.32
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 2500.0,
        "resonance": 0.15
      }
    },
    "mix_a": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.9
      }
    },
    "mix_b": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "noise_mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 1.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.7,
        "gain_3": 0.4
      }
    },
    "phaser": {
      "type": "Phaser",
      "params": {
        "rate": 0.08,
        "depth": 0.6,
        "stages": 4,
        "feedback": 0.3,
        "mix": 0.4
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.9,
        "damping": 0.3,
        "mix": 0.5
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc_a/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc_a/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc_a/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "osc_b/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc_b/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc_b/velocities"
    },
    {
      "from": "osc_a/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filter/output",
      "to": "mix_a/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_a/amp_env_audio"
    },
    {
      "from": "osc_b/output",
      "to": "mix_b/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_b/amp_env_audio"
    },
    {
      "from": "noise/output",
      "to": "noise_mix/input"
    },
    {
      "from": "amp_env/value",
      "to": "noise_mix/amp_env_audio"
    },
    {
      "from": "mix_a/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_b/output",
      "to": "sum/input_2"
    },
    {
      "from": "noise_mix/output",
      "to": "sum/input_3"
    },
    {
      "from": "sum/output",
      "to": "phaser/input"
    },
    {
      "from": "phaser/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc_a/lane_ids"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc_b/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "noise/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "noise/gates"
    },
    {
      "from": "voices/velocities",
      "to": "noise/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "noise/lane_ids"
    },
    {
      "from": "voices/velocities",
      "to": "noise_mix/velocities"
    }
  ]
}
