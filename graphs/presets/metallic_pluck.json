{
  "meta": {
    "id": "metallic_pluck",
    "title": "Metallic Pluck",
    "description": "This patch should sound like a metallic pluck with a fast attack, quick decay, and crisp transient detail. It is built from a wavetable voice.",
    "tags": [
      "pluck",
      "wavetable",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 133,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "osc": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.3,
        "amplitude": 0.3,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 1,
        "wavetable_source": 0,
        "wavetable_family": 3,
        "wavetable_member": 0,
        "attack": 0.001,
        "decay": 0.4,
        "sustain": 0.0,
        "release": 0.3
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 5,
        "cutoff": 3000.0,
        "resonance": 0.5
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.001,
        "decay": 0.4,
        "sustain": 0.0,
        "release": 0.3
      }
    },
    "filt_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.001,
        "decay": 0.3,
        "sustain": 0.0,
        "release": 0.3
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "osc/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    }
  ]
}
