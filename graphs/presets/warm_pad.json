{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 3,
        "position": 0.3,
        "amplitude": 0.25,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 4,
        "unison_spread": 30.0,
        "unison_stereo": 0.8,
        "unison_spread_mode": 1,
        "detune": 8.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 4000.0,
        "resonance": 0.1
      }
    },
    "amp_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.8,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 1.0,
        "decay": 0.8,
        "sustain": 0.3,
        "release": 1.5
      }
    },
    "filter_mod": {
      "type": "SpreadLFO",
      "params": {
        "frequency": 0.25,
        "amplitude": 0.15,
        "waveform": 0
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "amplitude": 0.12,
        "color": 1
      }
    },
    "noise_gain": {
      "type": "Gain",
      "params": {
        "gain": 1.0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gates"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gates"
    },
    {
      "from": "filt_env/envelopes",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "voices/gates",
      "to": "filter_mod/gates"
    },
    {
      "from": "filter_mod/values",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "noise/output",
      "to": "noise_gain/input"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/envelopes",
      "to": "mixer/amp_env"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_gain/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}