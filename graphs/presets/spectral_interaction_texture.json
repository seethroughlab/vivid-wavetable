{
  "meta": {
    "id": "spectral_interaction_texture",
    "title": "Spectral Interaction Texture",
    "description": "Advanced legacy spectral interaction texture retained for WavetableOsc mod_input behavior. This patch should sound like an evolving spectral texture where interaction creates shifting overtone color instead of simple clang. It is built from an analog carrier shaped by a moving wavetable modulator.",
    "tags": [
      "texture",
      "wavetable",
      "hybrid",
      "motion",
      "demo",
      "polyphonic",
      "legacy",
      "advanced"
    ],
    "difficulty": "advanced",
    "featured_rank": 128,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 96.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 4,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 3,
        "degree_2": 5,
        "degree_3": 4,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.16,
        "decay": 0.7,
        "sustain": 0.64,
        "release": 1.6
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.08,
        "decay": 0.8,
        "sustain": 0.22,
        "release": 1.1
      }
    },
    "modulator": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.62,
        "amplitude": 0.3,
        "warp_mode": 4,
        "warp_amount": 0.22,
        "phase_reset_mode": 1,
        "start_phase": 0.06,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 7
      }
    },
    "carrier": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 3,
        "amplitude": 0.24,
        "interaction_mode": 2,
        "interaction_depth": 0.48,
        "interaction_input_gain": 1.4,
        "interaction_tracking": 0.85
      }
    },
    "mod_pos_lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.07,
        "amplitude": 0.16,
        "waveform": 0,
        "offset": 0.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 2800.0,
        "resonance": 0.32,
        "keytrack": 0.5
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.16,
        "tone": 0.6,
        "mix": 0.44,
        "output_level": 1.0,
        "velocity_to_drive": 0.18
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.6,
        "glue": 0.12
      }
    },
    "delay": {
      "type": "PingPongDelay",
      "params": {
        "time": 0.26,
        "feedback": 0.3,
        "mix": 0.18
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.66,
        "mix": 0.28
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "mod_pos_lfo/value",
      "to": "modulator/position_mod_audio"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "drive/input"
    },
    {
      "from": "drive/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "delay/input"
    },
    {
      "from": "delay/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "carrier/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "modulator/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "drive/velocities"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "mixer/velocities"
    }
  ]
}
