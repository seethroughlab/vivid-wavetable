{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.01,
        "decay": 0.15,
        "sustain": 0.75,
        "release": 0.3
      }
    },
    "filt_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.01,
        "decay": 0.4,
        "sustain": 0.2,
        "release": 0.3
      }
    },
    "osc": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 1,
        "amplitude": 0.3,
        "detune": 10.0
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.5,
        "octave": 1,
        "waveform": 0
      }
    },
    "filter": {
      "type": "PolyFilter",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "filter_type": 1,
        "filter_cutoff": 3000.0,
        "filter_resonance": 0.2,
        "filter_drive": 0.15
      }
    },
    "dist": {
      "type": "Distortion",
      "params": {
        "drive": 1.5,
        "tone": 0.5,
        "level": 0.9,
        "mix": 0.3
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.3
      }
    },
    "sub_mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.4,
        "mix": 0.15
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gates"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gates"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "sub/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "sub/gates"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "filter/gates"
    },
    {
      "from": "filt_env/envelopes",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "dist/input"
    },
    {
      "from": "dist/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/envelopes",
      "to": "mixer/amp_env"
    },
    {
      "from": "sub/output",
      "to": "sub_mix/input"
    },
    {
      "from": "amp_env/envelopes",
      "to": "sub_mix/amp_env"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "sub_mix/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}