{
  "meta": {
    "id": "low_brass_pad",
    "title": "Low Brass Pad",
    "description": "This patch should sound like a warm low brass pad with steady breath, layered harmonic body, and soft glued weight across each chord. The analog and wavetable layers should feel unified rather than like separate instruments.",
    "tags": [
      "brass",
      "pad",
      "wavetable",
      "hybrid",
      "noise-layer",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 106,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 78.0
      }
    },
    "chords": {
