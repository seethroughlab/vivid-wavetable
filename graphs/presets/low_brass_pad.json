        "depth": 0.16,
        "voices": 3,
        "mix": 0.12
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.76,
        "mix": 0.24
      }
    },
    "out": {
      "type": "audio_out"
    }
