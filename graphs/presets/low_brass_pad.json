        "mode": 1,
        "degree_0": 0,
        "degree_1": 3,
        "degree_2": 5,
        "degree_3": 4,
        "voicing_0": 2,
        "voicing_1": 2,
        "voicing_2": 1,
        "voicing_3": 2
      }
    },
    "voices": {
