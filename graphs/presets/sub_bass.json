{
  "meta": {
    "id": "sub_bass",
    "title": "Sub Bass",
    "description": "This patch should sound like a sub-layered bass with focused low end, firm envelope control, and enough harmonic edge to cut. It is built from a wavetable voice reinforced by a sub layer.",
    "tags": [
      "bass",
      "wavetable",
      "hybrid",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 152,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "osc": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.0,
        "amplitude": 0.35,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 1,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 6,
        "cutoff": 800.0,
        "resonance": 0.3,
        "drive": 0.15
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.2,
        "sustain": 0.9,
        "release": 0.15
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.2,
        "sustain": 0.3,
        "release": 0.15
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.6,
        "octave": 0,
        "waveform": 3
      }
    },
    "sub_mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "sub/voices_out",
      "to": "sub_mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "sub_mixer/amp_env_audio"
    },
    {
      "from": "filter/output",
      "to": "sum/input_1"
    },
    {
      "from": "sub_mixer/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "osc/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "osc/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "sub/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    }
  ]
}
