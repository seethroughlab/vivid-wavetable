{
  "meta": {
    "id": "rooted_sub_bass",
    "title": "Rooted Sub Bass",
    "description": "This patch should sound like a grounded, sub-layered bass with focused low end, firm envelope control, and enough harmonic edge to cut. It is built from a wavetable voice reinforced by a sub layer.",
    "tags": [
      "bass",
      "wavetable",
      "hybrid",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 149,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 110.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 7,
        "mode": 1,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 3,
        "degree_3": 4,
        "voicing_0": 0,
        "voicing_1": 0,
        "voicing_2": 0,
        "voicing_3": 0
      }
    },
    "voices": {
      "type": "VoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 4
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.14,
        "sustain": 0.72,
        "release": 0.18
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.78,
        "amplitude": 0.17,
        "warp_mode": 2,
        "warp_amount": 0.26,
        "unison_voices": 2,
        "unison_spread": 8.0,
        "detune": 1.5,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 0
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.42,
        "octave": 1,
        "waveform": 0
      }
    },
    "mix_sub": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.15
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0
      }
    },
    "compressor": {
      "type": "Compressor",
      "params": {
        "threshold": -14.0,
        "ratio": 2.0,
        "attack": 0.01,
        "release": 0.18,
        "makeup_gain": 1.5
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "wt/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "wt/gates"
    },
    {
      "from": "voices/velocities",
      "to": "wt/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "wt/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "sub/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "sub/gates"
    },
    {
      "from": "voices/lane_ids",
      "to": "sub/lane_ids"
    },
    {
      "from": "sub/output",
      "to": "mix_sub/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_sub/amp_env_audio"
    },
    {
      "from": "wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_sub/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "compressor/input"
    },
    {
      "from": "compressor/output",
      "to": "out/input"
    },
    {
      "from": "voices/velocities",
      "to": "sub/velocities"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    }
  ]
}
