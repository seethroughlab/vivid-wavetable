{
  "meta": {
    "id": "silk_pad",
    "title": "Silk Pad",
    "description": "Minimal ultra-soft dreamy pad. Single AnalogWarm/Soft wavetable through a low-cut filter and reverb. No noise layer, no drive, no warp motion. Reference for what 'dreamy' should sound like in this library.",
    "tags": [
      "pad",
      "wavetable",
      "dreamy",
      "soft",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 100,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 64.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 3,
        "degree_3": 4,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1,
        "gate_length": 0.98,
        "octave": 4
      }
    },
    "osc": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 1,
        "pressure_to_amp": 0.0,
        "timbre_to_position": 0.0,
        "position": 0.25,
        "amplitude": 0.08,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 3,
        "unison_spread": 8.0,
        "unison_stereo": 0.7,
        "detune": 1.5,
        "attack": 1.4,
        "decay": 0.8,
        "sustain": 0.85,
        "release": 2.6
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 1100.0,
        "resonance": 0.12,
        "keytrack": 0.4
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.85,
        "mix": 0.45,
        "damping": 0.7
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    },
    "voice_breakout": {
      "type": "NoteBreakout",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "filter/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "osc/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    }
  ]
}
