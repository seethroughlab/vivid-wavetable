{
  "meta": {
    "id": "hollow_organ",
    "title": "Hollow Organ",
    "description": "This patch should sound like a hollow keys patch with defined attacks, musical sustain, and clear harmonic body. It is built from a wavetable voice reinforced by a sub layer.",
    "tags": [
      "keys",
      "wavetable",
      "hybrid",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 131,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.28,
        "amplitude": 0.23,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 1,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 2
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 7,
        "cutoff": 1800.0,
        "resonance": 0.18,
        "keytrack": 0.55
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.2,
        "sustain": 0.92,
        "release": 0.25
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.2,
        "sustain": 0.5,
        "release": 0.25
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.14,
        "octave": 0,
        "waveform": 1
      }
    },
    "sub_mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.3,
        "vel_to_volume": 0.6
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "voices/frequencies",
      "to": "sub/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "sub/gates"
    },
    {
      "from": "sub/output",
      "to": "sub_mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "sub_mixer/amp_env_audio"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "sub_mixer/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    },
    {
      "from": "voices/lane_ids",
      "to": "sub/lane_ids"
    },
    {
      "from": "voices/velocities",
      "to": "sub/velocities"
    }
  ]
}
