{
  "meta": {
    "id": "noise_osc_layer",
    "title": "Noise Osc Layer",
    "description": "This patch should sound like a noisy texture with evolving timbre, spacious bloom, and layered atmosphere. It is built from a wavetable voice. A per-note air layer adds breath and transient detail.",
    "tags": [
      "texture",
      "wavetable",
      "hybrid",
      "noise-layer",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 139,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.5,
        "decay": 0.6,
        "sustain": 0.5,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.5,
        "decay": 1.0,
        "sustain": 0.2,
        "release": 1.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.6,
        "amplitude": 0.2,
        "unison_voices": 3,
        "unison_spread": 20.0,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 0
      }
    },
    "noise": {
      "type": "NoiseLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "color": 1,
        "level": 0.1,
        "tone": 0.76,
        "tone_tracking": 0.22,
        "attack_burst": 0.22,
        "attack_decay_ms": 30.0,
        "velocity_to_level": 0.6
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 3000.0,
        "resonance": 0.15
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.3,
        "depth": 0.4,
        "mix": 0.3
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.7
      }
    },
    "noise_mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.9
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.6
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.7,
        "mix": 0.35
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "noise/output",
      "to": "noise_mix/input"
    },
    {
      "from": "amp_env/value",
      "to": "noise_mix/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_mix/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "noise/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "noise/gates"
    },
    {
      "from": "voices/velocities",
      "to": "noise/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "noise/lane_ids"
    },
    {
      "from": "voices/velocities",
      "to": "noise_mix/velocities"
    }
  ]
}
