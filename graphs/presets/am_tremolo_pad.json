{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.8,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 0,
        "amplitude": 0.3
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 3,
        "position": 0.4,
        "amplitude": 0.25,
        "unison_voices": 4,
        "unison_spread": 25.0,
        "mod_type": 3,
        "mod_depth": 0.6
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 3000.0,
        "resonance": 0.15
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.4,
        "depth": 0.3,
        "mix": 0.25
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.8
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.8,
        "mix": 0.4
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gates"
    },
    {
      "from": "voices/frequencies",
      "to": "modulator/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "modulator/gates"
    },
    {
      "from": "voices/velocities",
      "to": "modulator/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "carrier/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "carrier/gates"
    },
    {
      "from": "voices/velocities",
      "to": "carrier/velocities"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filter/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/envelopes",
      "to": "mixer/amp_env"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}