{
  "meta": {
    "id": "hybrid_keys_module_demo",
    "title": "Hybrid Keys Module Demo",
    "description": "This patch should sound like a clean, playable hybrid keys instrument while also proving that the HybridKeys module is easier to wire than the raw graph.",
    "tags": [
      "keys",
      "module",
      "wavetable",
      "hybrid",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 210,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 104.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 0,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 3,
        "degree_3": 4,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 2,
        "voicing_3": 1
      }
    },
    "instrument": {
      "type": "HybridKeys",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_family": 0,
        "wavetable_member": 1,
        "wavetable_position": 0.28,
        "analog_blend": 0.68,
        "filter_cutoff": 3600.0,
        "filter_resonance": 0.18,
        "amp_attack": 0.01,
        "amp_release": 0.4,
        "drive": 0.14,
        "output_level": 0.92
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "instrument/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "instrument/notes_in"
    }
  ]
}
