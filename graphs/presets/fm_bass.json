{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.005,
        "decay": 0.2,
        "sustain": 0.8,
        "release": 0.15
      }
    },
    "filt_env": {
      "type": "SpreadADSR",
      "params": {
        "attack": 0.005,
        "decay": 0.3,
        "sustain": 0.2,
        "release": 0.15
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 2,
        "amplitude": 0.4
      }
    },
    "carrier": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 1,
        "amplitude": 0.35,
        "mod_type": 1,
        "mod_depth": 0.3
      }
    },
    "filter": {
      "type": "PolyFilter",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "filter_type": 6,
        "filter_cutoff": 1000.0,
        "filter_resonance": 0.4,
        "filter_drive": 0.3
      }
    },
    "dist": {
      "type": "Distortion",
      "params": {
        "drive": 2.5,
        "tone": 0.3,
        "level": 0.8,
        "mix": 0.6
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gates"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gates"
    },
    {
      "from": "voices/frequencies",
      "to": "modulator/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "modulator/gates"
    },
    {
      "from": "voices/velocities",
      "to": "modulator/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "carrier/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "carrier/gates"
    },
    {
      "from": "voices/velocities",
      "to": "carrier/velocities"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "filter/gates"
    },
    {
      "from": "filt_env/envelopes",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "dist/input"
    },
    {
      "from": "dist/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/envelopes",
      "to": "mixer/amp_env"
    },
    {
      "from": "mixer/output",
      "to": "out/input"
    }
  ]
}