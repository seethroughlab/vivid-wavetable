{
  "meta": {
    "id": "compressed_pluck",
    "title": "Compressed Pluck",
    "description": "This patch should sound like a compressed pluck with a fast attack, quick decay, and crisp transient detail. It is built from a wavetable voice.",
    "tags": [
      "pluck",
      "wavetable",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 112,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 0.3,
        "sustain": 0.0,
        "release": 0.2
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 0.2,
        "sustain": 0.0,
        "release": 0.15
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.3,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 8000.0,
        "resonance": 0.15,
        "keytrack": 0.5
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.3,
        "vel_to_volume": 1.0
      }
    },
    "comp": {
      "type": "Compressor",
      "params": {
        "threshold": -18.0,
        "ratio": 6.0,
        "attack": 2.0,
        "release": 80.0
      }
    },
    "ppd": {
      "type": "PingPongDelay",
      "params": {
        "time": 250.0,
        "feedback": 0.35,
        "spread": 1.0,
        "mix": 0.3
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "comp/input"
    },
    {
      "from": "comp/output",
      "to": "ppd/input"
    },
    {
      "from": "ppd/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
