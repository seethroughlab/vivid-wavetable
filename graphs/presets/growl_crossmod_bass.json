      },
      "params": {
        "waveform": 1,
        "amplitude": 0.5
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.32,
        "amplitude": 0.22,
        "phase_reset_mode": 1,
        "start_phase": 0.03,
        "interaction_mode": 1,
        "interaction_depth": 0.34,
        "interaction_input_gain": 1.75,
        "interaction_tracking": 0.7,
        "wavetable_source": 0,
        "wavetable_family": 4,
        "wavetable_member": 6
      }
    },
    "sub": {
