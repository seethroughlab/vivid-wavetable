{
  "meta": {
    "id": "growl_crossmod_bass",
    "title": "Growl Crossmod Bass",
    "description": "Advanced legacy cross-mod bass retained for WavetableOsc FM behavior. This patch should sound like a weighty growl bass with controlled FM bite, solid sub support, and a musical medium-depth interaction range. It is built from a wavetable carrier reinforced by a sub layer and driven by an analog modulator.",
    "tags": [
      "bass",
      "wavetable",
      "hybrid",
      "motion",
      "demo",
      "polyphonic",
      "legacy",
      "advanced"
    ],
    "difficulty": "intermediate",
    "featured_rank": 127,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 118.0
      }
    },
    "pattern": {
      "type": "NotePatternAu",
      "params": {
        "steps": 4,
        "root_0": 0,
        "root_1": 7,
        "root_2": 3,
        "root_3": 5,
        "type_0": 0,
        "type_1": 0,
        "type_2": 0,
        "type_3": 0,
        "octave": 2,
        "beats_per_step": 2,
        "gate_length": 0.9,
        "velocity": 0.92
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.004,
        "decay": 0.18,
        "sustain": 0.88,
        "release": 0.18
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.004,
        "decay": 0.22,
        "sustain": 0.28,
        "release": 0.18
      }
    },
    "modulator": {
