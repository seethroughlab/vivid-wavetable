        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.28,
        "octave": 0,
        "waveform": 2,
        "velocity_to_level": 0.38
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 6,
        "cutoff": 920.0,
        "resonance": 0.42,
        "drive": 0.24,
        "keytrack": 0.55
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.36,
        "tone": 0.46,
        "mix": 0.86,
        "output_level": 0.95,
        "velocity_to_drive": 0.28
      }
    },
    "bass_mix": {
      "type": "VoiceMixer",
      "pkg": {
