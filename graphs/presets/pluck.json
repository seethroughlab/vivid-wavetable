{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 2,
        "position": 0.5,
        "amplitude": 0.3,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 1
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 8000.0,
        "resonance": 0.15
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.001,
        "decay": 0.3,
        "sustain": 0.0,
        "release": 0.2
      }
    },
    "filt_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.001,
        "decay": 0.25,
        "sustain": 0.0,
        "release": 0.2
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.5
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gate",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gate"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}