{
  "meta": {
    "id": "bit_crush_bass",
    "title": "Bit Crush Bass",
    "description": "This patch should sound like a bit-crushed bass with focused low end, firm envelope control, and enough harmonic edge to cut. It is built from a wavetable voice.",
    "tags": [
      "bass",
      "wavetable",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 108,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.3,
        "amplitude": 0.35,
        "warp_mode": 6,
        "warp_amount": 0.5,
        "unison_voices": 2,
        "unison_spread": 10.0,
        "detune": 5.0,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 4
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 6,
        "cutoff": 1200.0,
        "resonance": 0.35,
        "drive": 0.25
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.005,
        "decay": 0.25,
        "sustain": 0.8,
        "release": 0.15
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.005,
        "decay": 0.3,
        "sustain": 0.3,
        "release": 0.15
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.5
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
