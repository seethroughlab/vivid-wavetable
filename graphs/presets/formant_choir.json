{
  "meta": {
    "id": "formant_choir",
    "title": "Formant Choir",
    "description": "This patch should sound like a formant-shaped choir patch with vowel-like color, gentle ensemble spread, and soft sustain. It is built from a wavetable voice.",
    "tags": [
      "choir",
      "wavetable",
      "subtractive",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 127,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.25,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 8,
        "unison_spread": 45.0,
        "unison_stereo": 1.0,
        "unison_spread_mode": 1,
        "detune": 18.0,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 7,
        "cutoff": 2500.0,
        "resonance": 0.4
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.6,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.8,
        "decay": 1.2,
        "sustain": 0.4,
        "release": 1.5
      }
    },
    "filter_mod": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.22,
        "amplitude": 0.12,
        "waveform": 0
      }
    },
    "pan_mod": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.1,
        "amplitude": 0.25,
        "waveform": 0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter_mod/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "pan_mod/value",
      "to": "mixer/pan_mod_audio"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
