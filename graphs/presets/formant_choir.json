{
  "meta": {
    "id": "formant_choir",
    "title": "Formant Choir",
    "description": "This patch should sound like a formant-shaped choir patch with vowel-like color, gentle ensemble spread, and soft sustain. A DualFilter Formant stage provides the vowel shaping while LP12 keeps the top musical.",
    "tags": [
      "choir",
      "wavetable",
      "subtractive",
      "motion",
      "demo",
      "polyphonic",
      "dual-filter",
      "vocal"
    ],
    "difficulty": "intermediate",
    "featured_rank": 127,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "osc": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.25,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "unison_voices": 8,
        "unison_spread": 45.0,
        "unison_stereo": 1.0,
        "unison_spread_mode": 1,
        "detune": 18.0,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "dual_filter": {
      "type": "DualFilter",
      "params": {
        "routing": 0,
        "a_mode": 7,
        "a_cutoff": 2500.0,
        "a_resonance": 0.4,
        "a_drive": 0.0,
        "a_keytrack": 0.3,
        "b_mode": 0,
        "b_cutoff": 6000.0,
        "b_resonance": 0.04,
        "b_drive": 0.0,
        "b_keytrack": 0.1,
        "output_gain": 1.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.6,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.8,
        "decay": 1.2,
        "sustain": 0.4,
        "release": 1.5
      }
    },
    "filter_mod": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.22,
        "amplitude": 0.12,
        "waveform": 0
      }
    },
    "pan_mod": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.1,
        "amplitude": 0.25,
        "waveform": 0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "osc/output",
      "to": "dual_filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "dual_filter/a_cutoff_mod"
    },
    {
      "from": "filter_mod/value",
      "to": "dual_filter/a_cutoff_cv"
    },
    {
      "from": "dual_filter/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "osc/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "osc/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "dual_filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    }
  ]
}
