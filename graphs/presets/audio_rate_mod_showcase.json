{
  "meta": {
    "id": "audio_rate_mod_showcase",
    "title": "Audio Rate Mod Showcase",
    "description": "This patch should function as a clear reference that exposes modulation motion and response without hiding the underlying synthesis behavior. It is built from a wavetable voice.",
    "tags": [
      "wavetable",
      "subtractive",
      "motion",
      "reference",
      "polyphonic"
    ],
    "difficulty": "advanced",
    "featured_rank": 106,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 90.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 4,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 3,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 6,
        "portamento": 80.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.5,
        "amplitude": 0.9,
        "warp_mode": 4,
        "warp_amount": 0.3,
        "detune": 6.0,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 0
      }
    },
    "pos_lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.12,
        "amplitude": 0.35,
        "waveform": 0,
        "offset": 0.0
      }
    },
    "warp_lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.08,
        "amplitude": 0.25,
        "waveform": 0,
        "offset": 0.0
      }
    },
    "vibrato_lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 5.5,
        "amplitude": 0.15,
        "waveform": 0,
        "offset": 0.0
      }
    },
    "pan_lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.2,
        "amplitude": 0.4,
        "waveform": 0,
        "offset": 0.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 3200.0,
        "resonance": 0.2,
        "keytrack": 0.5
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 1.2,
        "decay": 0.6,
        "sustain": 0.6,
        "release": 2.0
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.8,
        "decay": 1.0,
        "sustain": 0.2,
        "release": 1.5
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.6
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.65,
        "mix": 0.3
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "pos_lfo/value",
      "to": "osc/position_mod_audio"
    },
    {
      "from": "warp_lfo/value",
      "to": "osc/warp_mod_audio"
    },
    {
      "from": "vibrato_lfo/value",
      "to": "osc/pitch_mod_audio"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "pan_lfo/value",
      "to": "mixer/pan_mod_audio"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    }
  ]
}
