{
  "meta": {
    "id": "cinematic_haze_bed",
    "title": "Cinematic Haze Bed",
    "description": "This patch should sound like a cinematic haze bed with broad bloom, slow harmonic lift, and enough body to hold a score underneath dialogue or picture. It is built from a wavetable and analog hybrid voice.",
    "tags": [
      "pad",
      "texture",
      "wavetable",
      "hybrid",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 7,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 74.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 11,
        "mode": 1,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 6,
        "degree_3": 3,
        "voicing_0": 2,
        "voicing_1": 1,
        "voicing_2": 2,
        "voicing_3": 1,
        "gate_length": 0.95
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 1.2,
        "decay": 0.9,
        "sustain": 0.82,
        "release": 2.2
      }
    },
    "pos_lfo": {
      "type": "Lfo",
      "params": {
        "rate": 0.05,
        "depth": 0.16,
        "shape": 1
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.62,
        "amplitude": 0.0456,
        "warp_mode": 4,
        "warp_amount": 0.2,
        "unison_voices": 4,
        "unison_spread": 18.0,
        "unison_stereo": 0.85,
        "detune": 5.0,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 0,
        "attack": 1.2,
        "decay": 0.9,
        "sustain": 0.82,
        "release": 2.2
      }
    },
    "analog": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 1,
        "amplitude": 0.0192,
        "detune": 2.5
      }
    },
    "mix_analog": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.28
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.55
      }
    },
    "phaser": {
      "type": "Phaser",
      "params": {
        "rate": 0.08,
        "depth": 0.38,
        "feedback": 0.18,
        "mix": 0.24
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.88,
        "mix": 0.42
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    },
    "voice_breakout": {
      "type": "NoteBreakout",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "pos_lfo/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "analog/voices_out",
      "to": "mix_analog/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_analog/amp_env_audio"
    },
    {
      "from": "wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_analog/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "phaser/input"
    },
    {
      "from": "phaser/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "analog/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    }
  ]
}
