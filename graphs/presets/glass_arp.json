{
  "meta": {
    "id": "glass_arp",
    "title": "Glass Arp",
    "description": "This patch should sound like a glassy arpeggio patch with rhythmic note separation and animated timbral movement. It is built from a wavetable/analog hybrid voice.",
    "tags": [
      "arp",
      "wavetable",
      "hybrid",
      "subtractive",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 128,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 0.5,
        "sustain": 0.0,
        "release": 0.3
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 0,
        "amplitude": 0.4
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.4,
        "amplitude": 0.25,
        "mod_type": 1,
        "mod_depth": 0.3,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 6000.0,
        "resonance": 0.1,
        "keytrack": 0.5
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.5
      }
    },
    "ppd": {
      "type": "PingPongDelay",
      "params": {
        "time": 200.0,
        "feedback": 0.45,
        "spread": 1.0,
        "mix": 0.4
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.6,
        "mix": 0.3
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "modulator/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "modulator/gates"
    },
    {
      "from": "voices/velocities",
      "to": "modulator/velocities"
    },
    {
      "from": "voices/frequencies",
      "to": "carrier/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "carrier/gates"
    },
    {
      "from": "voices/velocities",
      "to": "carrier/velocities"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "ppd/input"
    },
    {
      "from": "ppd/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "modulator/lane_ids"
    },
    {
      "from": "voices/lane_ids",
      "to": "carrier/lane_ids"
    }
  ]
}
