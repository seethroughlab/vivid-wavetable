{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 4,
        "position": 0.82,
        "amplitude": 0.21,
        "warp_mode": 6,
        "warp_amount": 0.36,
        "unison_voices": 2,
        "unison_spread": 18.0,
        "unison_stereo": 0.35
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 2,
        "cutoff": 2400.0,
        "resonance": 0.3,
        "drive": 0.35
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.04,
        "decay": 0.5,
        "sustain": 0.34,
        "release": 0.5
      }
    },
    "filt_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.08,
        "decay": 0.7,
        "sustain": 0.15,
        "release": 0.45
      }
    },
    "warp_mod": {
      "type": "SpreadLFO",
      "params": {
        "frequency": 0.5,
        "amplitude": 0.18,
        "waveform": 4
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "amplitude": 0.22,
        "color": 0
      }
    },
    "noise_gain": {
      "type": "Gain",
      "params": {
        "gain": 1.0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.65
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gate",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gate"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "voices/gates",
      "to": "warp_mod/gate"
    },
    {
      "from": "warp_mod/values",
      "to": "osc/warp_mod"
    },
    {
      "from": "noise/output",
      "to": "noise_gain/input"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_gain/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}