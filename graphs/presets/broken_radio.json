{
  "meta": {
    "id": "broken_radio",
    "title": "Broken Radio",
    "description": "This patch should sound like a broken-radio texture with evolving timbre, spacious bloom, and layered atmosphere. It is built from a wavetable voice. A per-note air layer adds breath and transient detail.",
    "tags": [
      "texture",
      "wavetable",
      "hybrid",
      "noise-layer",
      "subtractive",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 110,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.82,
        "amplitude": 0.21,
        "warp_mode": 6,
        "warp_amount": 0.36,
        "unison_voices": 2,
        "unison_spread": 18.0,
        "unison_stereo": 0.35,
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 2,
        "cutoff": 2400.0,
        "resonance": 0.3,
        "drive": 0.35
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.04,
        "decay": 0.5,
        "sustain": 0.34,
        "release": 0.5
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.08,
        "decay": 0.7,
        "sustain": 0.15,
        "release": 0.45
      }
    },
    "warp_mod": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.5,
        "amplitude": 0.18,
        "waveform": 4
      }
    },
    "noise": {
      "type": "NoiseLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "color": 0,
        "level": 0.09,
        "tone": 0.86,
        "tone_tracking": 0.28,
        "attack_burst": 0.58,
        "attack_decay_ms": 20.0,
        "velocity_to_level": 0.72
      }
    },
    "noise_gain": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.66
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.65
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "warp_mod/value",
      "to": "osc/warp_mod_audio"
    },
    {
      "from": "noise/output",
      "to": "noise_gain/input"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_gain/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "noise/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "noise/gates"
    },
    {
      "from": "voices/velocities",
      "to": "noise/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "noise/lane_ids"
    },
    {
      "from": "amp_env/value",
      "to": "noise_gain/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "noise_gain/velocities"
    }
  ]
}
