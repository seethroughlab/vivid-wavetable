{
  "meta": {
    "id": "modern_glass_lead",
    "title": "Modern Glass Lead",
    "description": "This patch should sound like a modern, glassy lead with strong midrange presence and expressive top-end motion. It is built from a wavetable voice.",
    "tags": [
      "lead",
      "wavetable",
      "motion",
      "sequenced",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 135,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 118.0
      }
    },
    "pattern": {
      "type": "NotePatternAu",
      "params": {
        "steps": 4,
        "root_0": 0,
        "root_1": 2,
        "root_2": 7,
        "root_3": 9,
        "type_0": 0,
        "type_1": 0,
        "type_2": 5,
        "type_3": 1,
        "octave": 5,
        "beats_per_step": 1,
        "gate_length": 0.84,
        "velocity": 0.92
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 2,
        "portamento": 18.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.02,
        "decay": 0.16,
        "sustain": 0.7,
        "release": 0.24
      }
    },
    "warp_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.11,
        "depth": 0.1,
        "shape": 0
      }
    },
    "wt": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 5,
        "position": 0.18,
        "amplitude": 0.15,
        "warp_mode": 0,
        "warp_amount": 0.0,
        "position_smooth_ms": 10.0,
        "warp_smooth_ms": 12.0,
        "phase_reset_mode": 1,
        "start_phase": 0.06,
        "phase_random": 0.08,
        "stereo_phase_offset": 0.34,
        "drift_amount": 0.1,
        "drift_rate_hz": 0.16,
        "unison_voices": 3,
        "unison_spread": 8.0,
        "unison_stereo": 0.48,
        "unison_output_mode": 1,
        "detune": 1.8
      }
    },
    "mix": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 1,
        "stereo_spread": 0.46
      }
    },
    "delay": {
      "type": "PingPongDelay",
      "params": {
        "time": 0.2,
        "feedback": 0.14,
        "mix": 0.1
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "pattern/beat_phase"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "pattern/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "pattern/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "pattern/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "wt/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "wt/gates"
    },
    {
      "from": "voices/velocities",
      "to": "wt/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "wt/lane_ids"
    },
    {
      "from": "warp_lfo/value",
      "to": "wt/warp_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "mix/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix/amp_env_audio"
    },
    {
      "from": "mix/output",
      "to": "delay/input"
    },
    {
      "from": "delay/output",
      "to": "out/input"
    }
  ]
}
