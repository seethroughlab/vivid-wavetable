{
  "meta": {
    "id": "controlled_metallic_lead",
    "title": "Controlled Metallic Lead",
    "description": "Advanced legacy interaction lead retained for WavetableOsc PM behavior. This patch should sound like a metallic lead with a clear sweet spot at medium interaction depth, firm note center, and no runaway clang. It is built from a wavetable carrier driven by an analog modulator.",
    "tags": [
      "lead",
      "wavetable",
      "hybrid",
      "motion",
      "demo",
      "mono",
      "legacy",
      "advanced"
    ],
    "difficulty": "intermediate",
    "featured_rank": 125,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 122.0
      }
    },
    "pattern": {
      "type": "NotePatternAu",
      "params": {
        "steps": 4,
        "root_0": 0,
        "root_1": 7,
        "root_2": 5,
        "root_3": 10,
        "type_0": 0,
        "type_1": 0,
        "type_2": 0,
        "type_3": 0,
        "octave": 4,
        "beats_per_step": 2,
        "gate_length": 0.78,
        "velocity": 0.9
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.008,
        "decay": 0.14,
        "sustain": 0.7,
        "release": 0.24
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.24,
        "sustain": 0.22,
        "release": 0.22
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 0,
        "amplitude": 0.58
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.38,
        "amplitude": 0.28,
        "phase_reset_mode": 1,
        "start_phase": 0.03,
        "interaction_mode": 2,
        "interaction_depth": 0.56,
        "interaction_input_gain": 1.65,
        "interaction_tracking": 0.9,
        "wavetable_source": 0,
        "wavetable_family": 3,
        "wavetable_member": 4
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 5,
        "cutoff": 2600.0,
        "resonance": 0.46,
        "keytrack": 0.82
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.3,
        "tone": 0.58,
        "mix": 0.75,
        "output_level": 1.0,
        "velocity_to_drive": 0.32
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.24,
        "glue": 0.12
      }
    },
    "delay": {
      "type": "Delay",
      "params": {
        "time": 190.0,
        "feedback": 0.26,
        "mix": 0.16
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.44,
        "mix": 0.15
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "pattern/beat_phase"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "drive/input"
    },
    {
      "from": "drive/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "delay/input"
    },
    {
      "from": "delay/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "pattern/notes_out",
      "to": "carrier/notes_in"
    },
    {
      "from": "pattern/notes_out",
      "to": "modulator/notes_in"
    },
    {
      "from": "pattern/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "drive/velocities"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "mixer/velocities"
    }
  ]
}
