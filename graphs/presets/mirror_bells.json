{
  "meta": {
    "id": "mirror_bells",
    "title": "Mirror Bells",
    "description": "This patch should sound like a mirror-warped bell patch with bright transients and lingering resonant overtones. It is built from a wavetable voice.",
    "tags": [
      "bells",
      "wavetable",
      "subtractive",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 134,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.74,
        "amplitude": 0.16,
        "warp_mode": 4,
        "warp_amount": 0.48,
        "wavetable_source": 0,
        "wavetable_family": 3,
        "wavetable_member": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 5,
        "cutoff": 5200.0,
        "resonance": 0.58
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 1.1,
        "sustain": 0.0,
        "release": 0.7
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 0.9,
        "sustain": 0.0,
        "release": 0.6
      }
    },
    "pos_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.001,
        "decay": 0.9,
        "sustain": 0.0,
        "release": 0.4
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gates"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "pos_env/value",
      "to": "osc/position_mod_audio"
    },
    {
      "from": "filter/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "pos_env/gate"
    },
    {
      "from": "voices/lane_ids",
      "to": "osc/lane_ids"
    },
    {
      "from": "amp_env/value",
      "to": "osc/voice_gain_audio"
    }
  ]
}
