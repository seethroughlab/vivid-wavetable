{
  "meta": {
    "id": "ambient_air_bed",
    "title": "Ambient Air Bed",
    "description": "This patch should sound like an ambient air bed with slow-moving shimmer, dimensional breath, and a lightly glued harmonic core underneath the airy layer. The air should feel integrated with the notes rather than like detached hiss.",
    "tags": [
      "pad",
      "texture",
      "wavetable",
      "hybrid",
      "noise-layer",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "featured_rank": 22,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 72.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 11,
        "mode": 1,
        "degree_0": 0,
        "degree_1": 5,
        "degree_2": 6,
        "degree_3": 3,
        "voicing_0": 2,
        "voicing_1": 1,
        "voicing_2": 2,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 6,
        "portamento": 30.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.9,
        "decay": 0.8,
        "sustain": 0.82,
        "release": 2.4
      }
    },
    "air_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.35,
        "decay": 0.7,
        "sustain": 0.74,
        "release": 2.2
      }
    },
    "pos_lfo": {
      "type": "LfoAu",
      "params": {
        "rate": 0.05,
        "depth": 0.12,
        "shape": 1
      }
    },
    "wt": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 5,
        "wavetable_member": 7,
        "position": 0.6,
        "amplitude": 0.15,
        "warp_mode": 4,
        "warp_amount": 0.18,
        "phase_reset_mode": 1,
        "start_phase": 0.03,
        "unison_voices": 4,
        "unison_spread": 16.0,
        "unison_stereo": 0.5,
        "detune": 3.5
      }
    },
    "air": {
      "type": "NoiseLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "color": 1,
        "level": 0.08,
        "tone": 0.64,
        "tone_tracking": 0.18,
        "attack_burst": 0.08,
        "attack_decay_ms": 52.0,
        "velocity_to_level": 0.42
      }
    },
    "drive_wt": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.12,
        "tone": 0.46,
        "mix": 0.68,
        "output_level": 1.0,
        "velocity_to_drive": 0.08
      }
    },
    "mix_wt": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.76,
        "glue": 0.12
      }
    },
    "mix_air": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.88
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.34
      }
    },
    "phaser": {
      "type": "Phaser",
      "params": {
        "rate": 0.08,
        "depth": 0.34,
        "feedback": 0.12,
        "mix": 0.18
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.9,
        "mix": 0.4
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "air_env/gate"
    },
    {
      "from": "voices/frequencies",
      "to": "wt/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "wt/gates"
    },
    {
      "from": "voices/velocities",
      "to": "wt/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "wt/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "air/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "air/gates"
    },
    {
      "from": "voices/velocities",
      "to": "air/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "air/lane_ids"
    },
    {
      "from": "pos_lfo/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "drive_wt/input"
    },
    {
      "from": "voices/velocities",
      "to": "drive_wt/velocities"
    },
    {
      "from": "drive_wt/output",
      "to": "mix_wt/input"
    },
    {
      "from": "air/output",
      "to": "mix_air/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_wt/amp_env_audio"
    },
    {
      "from": "air_env/value",
      "to": "mix_air/amp_env_audio"
    },
    {
      "from": "voices/velocities",
      "to": "mix_wt/velocities"
    },
    {
      "from": "voices/velocities",
      "to": "mix_air/velocities"
    },
    {
      "from": "mix_wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_air/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "phaser/input"
    },
    {
      "from": "phaser/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}
