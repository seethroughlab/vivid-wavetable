{
  "meta": {
    "id": "crystal_pattern_arp",
    "title": "Crystal Pattern Arp",
    "description": "This patch should sound like a crystalline arpeggio patch with rhythmic note separation and animated timbral movement. It is built from a wavetable/analog hybrid voice.",
    "tags": [
      "arp",
      "wavetable",
      "hybrid",
      "sequenced",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 113,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 122.0
      }
    },
    "pattern": {
      "type": "NotePatternAu",
      "params": {
        "steps": 4,
        "root_0": 0,
        "root_1": 7,
        "root_2": 9,
        "root_3": 5,
        "type_0": 0,
        "type_1": 5,
        "type_2": 6,
        "type_3": 1,
        "octave": 4,
        "beats_per_step": 2,
        "gate_length": 0.78,
        "velocity": 0.84
      }
    },
    "arp": {
      "type": "ArpeggiatorAu",
      "params": {
        "mode": 0,
        "octaves": 2,
        "rate": 4,
        "gate_length": 0.78,
        "swing": 0.08,
        "mod_steps": 8,
        "vel_0": 1.0,
        "vel_1": 0.82,
        "vel_2": 0.92,
        "vel_3": 0.76,
        "vel_4": 1.0,
        "vel_5": 0.88,
        "vel_6": 0.95,
        "vel_7": 0.72,
        "tr_2": 12,
        "tr_6": -12
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 6,
        "portamento": 12.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.01,
        "decay": 0.12,
        "sustain": 0.55,
        "release": 0.18
      }
    },
    "wt": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.18,
        "amplitude": 0.22,
        "warp_mode": 1,
        "warp_amount": 0.12,
        "unison_voices": 2,
        "unison_spread": 9.0,
        "detune": 1.5,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 0
      }
    },
    "analog": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 0,
        "amplitude": 0.08
      }
    },
    "mix_wt": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.65
      }
    },
    "mix_analog": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.25
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.45
      }
    },
    "delay": {
      "type": "PingPongDelay",
      "params": {
        "time": 0.18,
        "feedback": 0.28,
        "mix": 0.18
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.54,
        "mix": 0.18
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "pattern/beat_phase"
    },
    {
      "from": "clock/beat_phase",
      "to": "arp/beat_phase"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "pattern/notes",
      "to": "arp/notes"
    },
    {
      "from": "pattern/velocities",
      "to": "arp/velocities"
    },
    {
      "from": "pattern/gates",
      "to": "arp/gates"
    },
    {
      "from": "arp/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "arp/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "arp/gates",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "wt/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "wt/gates"
    },
    {
      "from": "voices/velocities",
      "to": "wt/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "wt/lane_ids"
    },
    {
      "from": "voices/frequencies",
      "to": "analog/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "analog/gates"
    },
    {
      "from": "voices/velocities",
      "to": "analog/velocities"
    },
    {
      "from": "voices/lane_ids",
      "to": "analog/lane_ids"
    },
    {
      "from": "wt/output",
      "to": "mix_wt/input"
    },
    {
      "from": "analog/output",
      "to": "mix_analog/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_wt/amp_env_audio"
    },
    {
      "from": "amp_env/value",
      "to": "mix_analog/amp_env_audio"
    },
    {
      "from": "mix_wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_analog/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "delay/input"
    },
    {
      "from": "delay/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}
