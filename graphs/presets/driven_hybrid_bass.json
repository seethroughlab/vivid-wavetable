{
  "meta": {
    "id": "driven_hybrid_bass",
    "title": "Driven Hybrid Bass",
    "description": "This patch should sound like a driven hybrid bass with solid low-end support, controlled bite, and a tighter center than the broader pad voices. The wavetable edge and sub weight should move together as one instrument.",
    "tags": [
      "bass",
      "wavetable",
      "hybrid",
      "motion",
      "sequenced",
      "demo",
      "mono"
    ],
    "difficulty": "intermediate",
    "featured_rank": 108,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 110.0
      }
    },
    "pattern": {
      "type": "NotePatternAu",
      "params": {
        "steps": 8,
        "root_0": 0,
        "root_1": 0,
        "root_2": 7,
        "root_3": 7,
        "root_4": 5,
        "root_5": 5,
        "root_6": 3,
        "root_7": 2,
        "type_0": 0,
        "type_1": 0,
        "type_2": 0,
        "type_3": 0,
        "type_4": 0,
        "type_5": 0,
        "type_6": 0,
        "type_7": 0,
        "octave": 2,
        "beats_per_step": 0.5,
        "gate_length": 0.72,
        "velocity": 0.92
      }
    },
    "voices": {
