        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.1
      }
    },
    "mix_sub": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.82
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
