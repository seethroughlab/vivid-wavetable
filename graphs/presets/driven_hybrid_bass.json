      },
      "params": {
        "max_voices": 2,
        "portamento": 10.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.003,
        "decay": 0.16,
        "sustain": 0.42,
        "release": 0.12
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.002,
        "decay": 0.12,
        "sustain": 0.1,
        "release": 0.1
      }
    },
    "wt": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 6,
        "position": 0.16,
        "amplitude": 0.16,
        "warp_mode": 1,
        "warp_amount": 0.14,
        "phase_reset_mode": 1,
        "start_phase": 0.03,
        "unison_voices": 2,
        "unison_spread": 5.0,
        "unison_stereo": 0.08,
        "detune": 0.8
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.28,
        "velocity_to_level": 0.48,
        "octave": 1,
        "waveform": 0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 1450.0,
        "resonance": 0.18,
        "keytrack": 0.32
      }
    },
    "drive_wt": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.46,
        "tone": 0.34,
        "mix": 1.0,
        "output_level": 0.9,
        "velocity_to_drive": 0.3
      }
    },
    "drive_sub": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.2,
        "tone": 0.2,
        "mix": 0.72,
        "output_level": 0.98,
        "velocity_to_drive": 0.16
