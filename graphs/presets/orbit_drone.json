{
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "max_voices": 8,
        "portamento": 0.0
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable": 8,
        "position": 0.18,
        "amplitude": 0.17,
        "warp_mode": 7,
        "warp_amount": 0.22,
        "unison_voices": 4,
        "unison_spread": 22.0,
        "unison_stereo": 1.0,
        "unison_spread_mode": 2,
        "detune": 16.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 4,
        "cutoff": 2600.0,
        "resonance": 0.41
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 1.6,
        "decay": 1.1,
        "sustain": 0.78,
        "release": 3.6
      }
    },
    "filt_env": {
      "type": "Envelope",
      "params": {
        "attack": 1.4,
        "decay": 1.8,
        "sustain": 0.45,
        "release": 2.2
      }
    },
    "pos_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.02,
        "decay": 4.6,
        "sustain": 0.7,
        "release": 2.4
      }
    },
    "pitch_mod": {
      "type": "SpreadLFO",
      "params": {
        "frequency": 0.06,
        "amplitude": 0.08,
        "waveform": 0
      }
    },
    "pan_mod": {
      "type": "SpreadLFO",
      "params": {
        "frequency": 0.1,
        "amplitude": 0.3,
        "waveform": 0
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "amplitude": 0.06,
        "color": 0
      }
    },
    "noise_gain": {
      "type": "Gain",
      "params": {
        "gain": 1.0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 1.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "chords/notes",
      "to": "voices/notes_in"
    },
    {
      "from": "chords/velocities",
      "to": "voices/velocities_in"
    },
    {
      "from": "chords/gate",
      "to": "voices/gates_in"
    },
    {
      "from": "voices/frequencies",
      "to": "osc/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "osc/gate"
    },
    {
      "from": "voices/velocities",
      "to": "osc/velocities"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "voices/frequencies",
      "to": "filter/frequencies"
    },
    {
      "from": "voices/gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voices/gates",
      "to": "filt_env/gate"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "voices/gates",
      "to": "pos_env/gate"
    },
    {
      "from": "pos_env/value",
      "to": "osc/position_mod"
    },
    {
      "from": "voices/gates",
      "to": "pitch_mod/gate"
    },
    {
      "from": "pitch_mod/values",
      "to": "osc/pitch_mod"
    },
    {
      "from": "voices/gates",
      "to": "pan_mod/gate"
    },
    {
      "from": "pan_mod/values",
      "to": "mixer/pan_mod"
    },
    {
      "from": "noise/output",
      "to": "noise_gain/input"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env"
    },
    {
      "from": "voices/velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_gain/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    }
  ]
}