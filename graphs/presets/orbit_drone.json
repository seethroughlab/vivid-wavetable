{
  "meta": {
    "id": "orbit_drone",
    "title": "Orbit Drone",
    "description": "Advanced legacy drone retained for WavetableOsc feedback-style warp behavior. This patch should sound like an orbiting drone with long sustain, slow movement, and immersive weight. It is built from a wavetable voice. A per-note air layer adds breath and transient detail.",
    "tags": [
      "drone",
      "wavetable",
      "hybrid",
      "noise-layer",
      "subtractive",
      "motion",
      "demo",
      "polyphonic",
      "legacy",
      "advanced"
    ],
    "difficulty": "intermediate",
    "featured_rank": 142,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 2,
        "degree_2": 4,
        "degree_3": 5,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1,
        "gate_length": 0.95
      }
    },
    "osc": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.18,
        "amplitude": 0.17,
        "warp_mode": 7,
        "warp_amount": 0.22,
        "unison_voices": 4,
        "unison_spread": 22.0,
        "unison_stereo": 1.0,
        "unison_spread_mode": 2,
        "detune": 16.0,
        "wavetable_source": 0,
        "wavetable_family": 3,
        "wavetable_member": 0,
        "release": 2.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 4,
        "cutoff": 1500.0,
        "resonance": 0.2
      }
    },
    "amp_env": {
      "type": "Envelope",
      "params": {
        "attack": 1.6,
        "decay": 1.1,
        "sustain": 0.78,
        "release": 3.6
      }
    },
    "filt_env": {
      "type": "Envelope",
      "params": {
        "attack": 1.4,
        "decay": 1.8,
        "sustain": 0.45,
        "release": 2.2
      }
    },
    "pos_env": {
      "type": "Envelope",
      "params": {
        "attack": 0.02,
        "decay": 4.6,
        "sustain": 0.7,
        "release": 2.4
      }
    },
    "pitch_mod": {
      "type": "Lfo",
      "params": {
        "frequency": 0.06,
        "amplitude": 0.08,
        "waveform": 0
      }
    },
    "pan_mod": {
      "type": "Lfo",
      "params": {
        "frequency": 0.1,
        "amplitude": 0.3,
        "waveform": 0
      }
    },
    "noise": {
      "type": "NoiseLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "color": 0,
        "level": 0.005,
        "tone": 0.56,
        "tone_tracking": 0.12,
        "attack_burst": 0.04,
        "attack_decay_ms": 62.0,
        "velocity_to_level": 0.26
      }
    },
    "noise_gain": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 1.0
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 1.0
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0,
        "gain_3": 1.0
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.5,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    },
    "voice_breakout": {
      "type": "NoteBreakout",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "osc/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "pos_env/value",
      "to": "osc/position_mod_audio"
    },
    {
      "from": "pitch_mod/value",
      "to": "osc/pitch_mod_audio"
    },
    {
      "from": "pan_mod/value",
      "to": "mixer/pan_mod_audio"
    },
    {
      "from": "noise/voices_out",
      "to": "noise_gain/input"
    },
    {
      "from": "filter/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "sum/input_1"
    },
    {
      "from": "noise_gain/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "noise_gain/amp_env_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "noise/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "osc/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "mixer/velocities"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "noise_gain/velocities"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "pos_env/gate"
    }
  ]
}
