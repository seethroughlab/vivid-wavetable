{
  "meta": {
    "id": "fm_glass_keys",
    "title": "FM Glass Keys",
    "description": "Advanced legacy FM glass keys retained for WavetableOsc interaction behavior. This patch should sound like playable glassy keys with clear note attacks, bright harmonic shimmer, and a stable PM-style interaction core. It is built from a wavetable carrier shaped by an analog modulator.",
    "tags": [
      "keys",
      "wavetable",
      "hybrid",
      "motion",
      "demo",
      "polyphonic",
      "legacy",
      "advanced"
    ],
    "difficulty": "intermediate",
    "featured_rank": 124,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 112.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 1,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 4,
        "degree_2": 5,
        "degree_3": 3,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 1,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.004,
        "decay": 0.9,
        "sustain": 0.46,
        "release": 0.85
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.003,
        "decay": 0.42,
        "sustain": 0.18,
        "release": 0.35
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "waveform": 0,
        "amplitude": 0.52
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.22,
        "amplitude": 0.24,
        "unison_voices": 2,
        "unison_spread": 8.0,
        "unison_stereo": 0.32,
        "phase_reset_mode": 1,
        "start_phase": 0.05,
        "interaction_mode": 2,
        "interaction_depth": 0.42,
        "interaction_input_gain": 1.35,
        "interaction_tracking": 1.0,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 5
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 4200.0,
        "resonance": 0.14,
        "keytrack": 0.7
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "drive": 0.14,
        "tone": 0.64,
        "mix": 0.52,
        "output_level": 1.0,
        "velocity_to_drive": 0.2
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "stereo_spread": 0.36,
        "vel_to_volume": 1.0,
        "glue": 0.08
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.52,
        "mix": 0.2
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "modulator/output",
      "to": "carrier/mod_input"
    },
    {
      "from": "carrier/output",
      "to": "filter/input"
    },
    {
      "from": "filt_env/value",
      "to": "filter/cutoff_mod"
    },
    {
      "from": "filter/output",
      "to": "drive/input"
    },
    {
      "from": "drive/output",
      "to": "mixer/input"
    },
    {
      "from": "amp_env/value",
      "to": "mixer/amp_env_audio"
    },
    {
      "from": "mixer/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "carrier/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "modulator/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "drive/velocities"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "filt_env/gate"
    },
    {
      "from": "voice_breakout/voice_freqs",
      "to": "filter/frequencies"
    },
    {
      "from": "voice_breakout/voice_velocities",
      "to": "mixer/velocities"
    }
  ]
}
