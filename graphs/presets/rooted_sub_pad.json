{
  "meta": {
    "id": "rooted_sub_pad",
    "title": "Rooted Sub Pad",
    "description": "This patch should sound like a grounded, sub-layered sustained pad with soft motion and wide stereo bloom. It is built from a wavetable voice reinforced by a sub layer.",
    "tags": [
      "pad",
      "wavetable",
      "hybrid",
      "demo",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 150,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "ClockAu",
      "params": {
        "bpm": 88.0
      }
    },
    "chords": {
      "type": "ChordProgressionAu",
      "params": {
        "key": 9,
        "mode": 0,
        "degree_0": 0,
        "degree_1": 4,
        "degree_2": 5,
        "degree_3": 3,
        "voicing_0": 1,
        "voicing_1": 1,
        "voicing_2": 0,
        "voicing_3": 1
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.5,
        "decay": 0.6,
        "sustain": 0.76,
        "release": 1.6
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.34,
        "amplitude": 0.18,
        "warp_mode": 4,
        "warp_amount": 0.16,
        "unison_voices": 4,
        "unison_spread": 22.0,
        "unison_stereo": 0.8,
        "detune": 4.0,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 0
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "level": 0.28,
        "octave": 0,
        "waveform": 1
      }
    },
    "mix_sub": {
      "type": "VoiceMixer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.2
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.9
      }
    },
    "chorus": {
      "type": "Chorus",
      "params": {
        "rate": 0.18,
        "depth": 0.38,
        "voices": 4,
        "mix": 0.22
      }
    },
    "reverb": {
      "type": "Reverb",
      "params": {
        "room_size": 0.78,
        "mix": 0.28
      }
    },
    "out": {
      "type": "audio_out"
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "sub/voices_out",
      "to": "mix_sub/input"
    },
    {
      "from": "amp_env/value",
      "to": "mix_sub/amp_env_audio"
    },
    {
      "from": "wt/output",
      "to": "sum/input_1"
    },
    {
      "from": "mix_sub/output",
      "to": "sum/input_2"
    },
    {
      "from": "sum/output",
      "to": "chorus/input"
    },
    {
      "from": "chorus/output",
      "to": "reverb/input"
    },
    {
      "from": "reverb/output",
      "to": "out/input"
    },
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    },
    {
      "from": "chords/notes_out",
      "to": "sub/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "chords/notes_out",
      "to": "voice_breakout/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    }
  ]
}
