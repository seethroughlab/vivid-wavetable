{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "wavetable_osc_stress",
        "title": "WavetableOsc 4-Instance Stress (Legacy Comparison)",
        "description": "Four WavetableOsc + VoiceMixer instances matched to wavetable_layer_stress.json for apples-to-apples performance comparison. Same voice count, unison, families, and keys.",
        "tags": ["stress", "benchmark", "wavetable_osc", "legacy", "polyphonic"],
        "difficulty": "advanced",
        "requires_packages": ["vivid-wavetable"]
    },
    "nodes": {
        "clock": { "type": "ClockAu", "params": { "bpm": 96.0 } },
        "chords_1": { "type": "ChordProgressionAu", "params": { "key": 0.0, "mode": 0.0 } },
        "chords_2": { "type": "ChordProgressionAu", "params": { "key": 5.0, "mode": 0.0 } },
        "chords_3": { "type": "ChordProgressionAu", "params": { "key": 10.0, "mode": 0.0 } },
        "chords_4": { "type": "ChordProgressionAu", "params": { "key": 3.0, "mode": 0.0 } },
        "voices_1": { "type": "PolyVoiceAllocator", "pkg": { "name": "vivid-wavetable" }, "params": { "max_voices": 6 } },
        "voices_2": { "type": "PolyVoiceAllocator", "pkg": { "name": "vivid-wavetable" }, "params": { "max_voices": 6 } },
        "voices_3": { "type": "PolyVoiceAllocator", "pkg": { "name": "vivid-wavetable" }, "params": { "max_voices": 6 } },
        "voices_4": { "type": "PolyVoiceAllocator", "pkg": { "name": "vivid-wavetable" }, "params": { "max_voices": 6 } },
        "env_1": { "type": "EnvelopeAu", "params": { "attack": 0.1, "decay": 0.5, "sustain": 0.7, "release": 1.0 } },
        "env_2": { "type": "EnvelopeAu", "params": { "attack": 0.1, "decay": 0.5, "sustain": 0.7, "release": 1.0 } },
        "env_3": { "type": "EnvelopeAu", "params": { "attack": 0.1, "decay": 0.5, "sustain": 0.7, "release": 1.0 } },
        "env_4": { "type": "EnvelopeAu", "params": { "attack": 0.1, "decay": 0.5, "sustain": 0.7, "release": 1.0 } },
        "osc_1": {
            "type": "WavetableOsc",
            "pkg": { "name": "vivid-wavetable" },
            "params": { "amplitude": 0.18, "unison_voices": 4, "unison_spread": 16.0, "unison_stereo": 0.7, "unison_output_mode": 1, "wavetable_family": 0, "wavetable_member": 2 }
        },
        "osc_2": {
            "type": "WavetableOsc",
            "pkg": { "name": "vivid-wavetable" },
            "params": { "amplitude": 0.18, "unison_voices": 4, "unison_spread": 14.0, "unison_stereo": 0.8, "unison_output_mode": 1, "wavetable_family": 2, "wavetable_member": 0 }
        },
        "osc_3": {
            "type": "WavetableOsc",
            "pkg": { "name": "vivid-wavetable" },
            "params": { "amplitude": 0.18, "unison_voices": 4, "unison_spread": 18.0, "unison_stereo": 0.6, "unison_output_mode": 1, "wavetable_family": 4, "wavetable_member": 4 }
        },
        "osc_4": {
            "type": "WavetableOsc",
            "pkg": { "name": "vivid-wavetable" },
            "params": { "amplitude": 0.18, "unison_voices": 4, "unison_spread": 12.0, "unison_stereo": 0.9, "unison_output_mode": 1, "wavetable_family": 5, "wavetable_member": 6 }
        },
        "mix_1": { "type": "VoiceMixer", "pkg": { "name": "vivid-wavetable" }, "params": { "input_layout": 1, "stereo_spread": 0.7 } },
        "mix_2": { "type": "VoiceMixer", "pkg": { "name": "vivid-wavetable" }, "params": { "input_layout": 1, "stereo_spread": 0.8 } },
        "mix_3": { "type": "VoiceMixer", "pkg": { "name": "vivid-wavetable" }, "params": { "input_layout": 1, "stereo_spread": 0.6 } },
        "mix_4": { "type": "VoiceMixer", "pkg": { "name": "vivid-wavetable" }, "params": { "input_layout": 1, "stereo_spread": 0.9 } },
        "sum": { "type": "Mixer", "params": { "gain_1": 1.0, "gain_2": 1.0, "gain_3": 1.0, "gain_4": 1.0 } },
        "out": { "type": "audio_out" }
    },
    "connections": [
        { "from": "clock/beat_phase", "to": "chords_1/beat_phase" },
        { "from": "clock/beat_phase", "to": "chords_2/beat_phase" },
        { "from": "clock/beat_phase", "to": "chords_3/beat_phase" },
        { "from": "clock/beat_phase", "to": "chords_4/beat_phase" },

        { "from": "chords_1/notes", "to": "voices_1/notes_in" },
        { "from": "chords_1/velocities", "to": "voices_1/velocities_in" },
        { "from": "chords_1/gates", "to": "voices_1/gates_in" },
        { "from": "chords_2/notes", "to": "voices_2/notes_in" },
        { "from": "chords_2/velocities", "to": "voices_2/velocities_in" },
        { "from": "chords_2/gates", "to": "voices_2/gates_in" },
        { "from": "chords_3/notes", "to": "voices_3/notes_in" },
        { "from": "chords_3/velocities", "to": "voices_3/velocities_in" },
        { "from": "chords_3/gates", "to": "voices_3/gates_in" },
        { "from": "chords_4/notes", "to": "voices_4/notes_in" },
        { "from": "chords_4/velocities", "to": "voices_4/velocities_in" },
        { "from": "chords_4/gates", "to": "voices_4/gates_in" },

        { "from": "voices_1/gates", "to": "env_1/gate" },
        { "from": "voices_2/gates", "to": "env_2/gate" },
        { "from": "voices_3/gates", "to": "env_3/gate" },
        { "from": "voices_4/gates", "to": "env_4/gate" },

        { "from": "voices_1/frequencies", "to": "osc_1/frequencies" },
        { "from": "voices_1/gates", "to": "osc_1/gates" },
        { "from": "voices_1/velocities", "to": "osc_1/velocities" },
        { "from": "voices_1/lane_ids", "to": "osc_1/lane_ids" },

        { "from": "voices_2/frequencies", "to": "osc_2/frequencies" },
        { "from": "voices_2/gates", "to": "osc_2/gates" },
        { "from": "voices_2/velocities", "to": "osc_2/velocities" },
        { "from": "voices_2/lane_ids", "to": "osc_2/lane_ids" },

        { "from": "voices_3/frequencies", "to": "osc_3/frequencies" },
        { "from": "voices_3/gates", "to": "osc_3/gates" },
        { "from": "voices_3/velocities", "to": "osc_3/velocities" },
        { "from": "voices_3/lane_ids", "to": "osc_3/lane_ids" },

        { "from": "voices_4/frequencies", "to": "osc_4/frequencies" },
        { "from": "voices_4/gates", "to": "osc_4/gates" },
        { "from": "voices_4/velocities", "to": "osc_4/velocities" },
        { "from": "voices_4/lane_ids", "to": "osc_4/lane_ids" },

        { "from": "osc_1/output", "to": "mix_1/input" },
        { "from": "env_1/value", "to": "mix_1/amp_env_audio" },
        { "from": "voices_1/velocities", "to": "mix_1/velocities" },

        { "from": "osc_2/output", "to": "mix_2/input" },
        { "from": "env_2/value", "to": "mix_2/amp_env_audio" },
        { "from": "voices_2/velocities", "to": "mix_2/velocities" },

        { "from": "osc_3/output", "to": "mix_3/input" },
        { "from": "env_3/value", "to": "mix_3/amp_env_audio" },
        { "from": "voices_3/velocities", "to": "mix_3/velocities" },

        { "from": "osc_4/output", "to": "mix_4/input" },
        { "from": "env_4/value", "to": "mix_4/amp_env_audio" },
        { "from": "voices_4/velocities", "to": "mix_4/velocities" },

        { "from": "mix_1/output", "to": "sum/input_1" },
        { "from": "mix_2/output", "to": "sum/input_2" },
        { "from": "mix_3/output", "to": "sum/input_3" },
        { "from": "mix_4/output", "to": "sum/input_4" },

        { "from": "sum/output", "to": "out/input" }
    ]
}
