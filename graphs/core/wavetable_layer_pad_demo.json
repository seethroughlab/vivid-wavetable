{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "wavetable_layer_pad_demo",
    "title": "WavetableLayer Pad Demo",
    "description": "Self-playing pad demo built on the LayerPad module (WavetableLayer). Validates the production WavetableLayer path without VoiceMixer.",
    "tags": [
      "pad",
      "module",
      "wavetable",
      "wavetable_layer",
      "motion",
      "demo",
      "polyphonic"
    ],
    "difficulty": "beginner",
    "requires_packages": [
      "vivid-wavetable"
    ],
    "featured_rank": 215
  },
  "nodes": {
    "chords": {
      "type": "ChordProgression",
      "params": {
        "voicing_0": 1.0,
        "mode": 0.0,
        "degree_0": 0.0,
        "key": 4.0,
        "degree_3": 3.0,
        "voicing_1": 2.0,
        "degree_2": 4.0,
        "voicing_3": 2.0,
        "voicing_2": 1.0,
        "degree_1": 5.0,
        "gate_length": 0.95
      }
    },
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 88.0
      }
    },
    "instrument": {
      "type": "LayerPad",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "wavetable_family": 0.0,
        "wavetable_member": 1.0,
        "wavetable_position": 0.24,
        "motion_amount": 0.08,
        "motion_rate": 0.06,
        "warp_mode": 0.0,
        "warp_amount": 0.0,
        "unison_voices": 3.0,
        "unison_spread": 12.0,
        "output_level": 0.85
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "instrument/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "instrument/notes_in"
    }
  ],
  "mod_assignments": {
    "instrument": [
      {
        "source": "motion_lfo",
        "destination": "warp",
        "amount": 0.1,
        "polarity": "bipolar"
      }
    ]
  }
}
