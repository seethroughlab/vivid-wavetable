{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "wavetable_layer_filter_integration",
    "title": "WavetableLayer Filter Integration",
    "description": "Integration test proving WavetableLayer can feed an external mono Filter after stereo reduction. This retained fixture is a simple mono post-filter compatibility path, not a stereo split/recombine or per-note filter example.",
    "tags": [
      "integration",
      "wavetable_layer",
      "filter",
      "polyphonic"
    ],
    "difficulty": "intermediate",
    "featured_rank": 610,
    "requires_packages": [
      "vivid-wavetable"
    ]
  },
  "nodes": {
    "clock": {
      "type": "Clock",
      "params": {
        "bpm": 96.0
      }
    },
    "chords": {
      "type": "ChordProgression",
      "params": {
        "key": 4.0,
        "mode": 0.0,
        "gate_length": 0.95
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "amplitude": 0.05,
        "unison_voices": 3,
        "unison_spread": 14.0,
        "unison_stereo": 0.7,
        "wavetable_family": 0,
        "wavetable_member": 2,
        "position": 0.4,
        "attack": 0.1,
        "decay": 0.5,
        "sustain": 0.7,
        "release": 1.0
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 1800.0,
        "resonance": 0.15
      }
    },
    "out": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "chords/beat_phase"
    },
    {
      "from": "wt/output",
      "to": "filter/input"
    },
    {
      "from": "filter/output",
      "to": "out/input"
    },
    {
      "from": "chords/notes_out",
      "to": "wt/notes_in"
    }
  ]
}
