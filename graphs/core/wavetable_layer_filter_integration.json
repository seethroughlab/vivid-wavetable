{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "wavetable_layer_filter_integration",
        "title": "WavetableLayer Filter Integration",
        "description": "Integration test proving WavetableLayer can feed an external mono Filter with envelope-shaped, keytracked cutoff after stereo reduction. This is a truthful mono compatibility path, not a stereo split/recombine example.",
        "tags": [
            "integration",
            "wavetable_layer",
            "filter",
            "polyphonic"
        ],
        "difficulty": "intermediate",
        "requires_packages": [
            "vivid-wavetable"
        ]
    },
    "nodes": {
        "clock": { "type": "ClockAu", "params": { "bpm": 96.0 } },
        "chords": { "type": "ChordProgressionAu", "params": { "key": 4.0, "mode": 0.0 } },
        "voices": {
            "type": "PolyVoiceAllocator",
            "pkg": { "name": "vivid-wavetable" },
            "params": { "max_voices": 6 }
        },
        "amp_env": {
            "type": "EnvelopeAu",
            "params": { "attack": 0.1, "decay": 0.5, "sustain": 0.7, "release": 1.0 }
        },
        "filt_env": {
            "type": "EnvelopeAu",
            "params": { "attack": 0.02, "decay": 0.4, "sustain": 0.15, "release": 0.3, "amplitude": 0.3 }
        },
        "wt": {
            "type": "WavetableLayer",
            "pkg": { "name": "vivid-wavetable" },
            "params": {
                "amplitude": 0.25,
                "unison_voices": 3,
                "unison_spread": 14.0,
                "unison_stereo": 0.7,
                "wavetable_family": 0,
                "wavetable_member": 2,
                "position": 0.4
            }
        },
        "filter": {
            "type": "Filter",
            "params": { "mode": 1, "cutoff": 2000.0, "resonance": 0.15, "keytrack": 0.35 }
        },
        "out": { "type": "audio_out" }
    },
    "connections": [
        { "from": "clock/beat_phase", "to": "chords/beat_phase" },
        { "from": "chords/notes", "to": "voices/notes_in" },
        { "from": "chords/velocities", "to": "voices/velocities_in" },
        { "from": "chords/gates", "to": "voices/gates_in" },

        { "from": "voices/gates", "to": "amp_env/gate" },
        { "from": "voices/lane_ids", "to": "amp_env/lane_ids" },
        { "from": "voices/gates", "to": "filt_env/gate" },
        { "from": "voices/lane_ids", "to": "filt_env/lane_ids" },

        { "from": "voices/frequencies", "to": "wt/frequencies" },
        { "from": "voices/gates", "to": "wt/gates" },
        { "from": "voices/velocities", "to": "wt/velocities" },
        { "from": "voices/lane_ids", "to": "wt/lane_ids" },
        { "from": "amp_env/value", "to": "wt/voice_gain_audio" },

        { "from": "wt/output", "to": "filter/input" },
        { "from": "voices/frequencies", "to": "filter/frequencies" },
        { "from": "filt_env/value", "to": "filter/cutoff_mod" },

        { "from": "filter/output", "to": "out/input" }
    ]
}
