{
  "meta": {
    "title": "Pulse Bass",
    "description": "A vivid-sequencers note pattern feeding a tight PWM bass patch with sub support and ladder filtering.",
    "tags": ["wavetable", "sequencer", "bass", "pulse", "demo"],
    "difficulty": "beginner",
    "domains": ["audio"],
    "requires_packages": ["vivid-sequencers"]
  },
  "nodes": {
    "clock1": {
      "type": "Clock",
      "params": {
        "bpm": 110.0
      }
    },
    "pattern1": {
      "type": "NotePattern",
      "params": {
        "steps": 8,
        "octave": 2,
        "beats_per_step": 2,
        "gate_length": 0.62,
        "velocity": 0.95,
        "root_0": 0,
        "type_0": 1,
        "root_1": 0,
        "type_1": 1,
        "root_2": 7,
        "type_2": 1,
        "root_3": 7,
        "type_3": 1,
        "root_4": 5,
        "type_4": 1,
        "root_5": 3,
        "type_5": 1,
        "root_6": 0,
        "type_6": 1,
        "root_7": 10,
        "type_7": 1
      }
    },
    "synth1": {
      "type": "WavetableSynth",
      "pkg": {
        "name": "vivid-wavetable",
        "version": "0.1.0"
      },
      "params": {
        "wavetable": 5.0,
        "position": 0.18,
        "amplitude": 0.24,
        "warp_mode": 3.0,
        "warp_amount": 0.18,
        "sub_level": 0.45,
        "sub_octave": 0.0,
        "sub_waveform": 3.0,
        "portamento": 18.0,
        "attack": 0.005,
        "decay": 0.16,
        "sustain": 0.72,
        "release": 0.12,
        "filter_type": 6.0,
        "filter_cutoff": 950.0,
        "filter_resonance": 0.42,
        "filter_keytrack": 0.25,
        "filter_drive": 0.28,
        "filter_env_amount": 0.62,
        "vel_to_volume": 0.85,
        "stereo_spread": 0.2
      }
    },
    "out1": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "pattern1/beat_phase" },
    { "from": "pattern1/notes", "to": "synth1/notes" },
    { "from": "pattern1/velocities", "to": "synth1/velocities" },
    { "from": "pattern1/gates", "to": "synth1/gates" },
    { "from": "synth1/output", "to": "out1/input" }
  ]
}
