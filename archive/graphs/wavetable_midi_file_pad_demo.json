{
  "meta": {
    "title": "Midi File Wavetable Pad",
    "description": "A softer pad variant of the MidiFilePlayer demo, useful for validating looping, transpose, and MIDI-to-instrument wiring in vivid-wavetable.",
    "tags": ["midi", "file", "wavetable", "pad", "demo"],
    "difficulty": "beginner",
    "domains": ["audio"]
  },
  "nodes": {
    "midi1": {
      "type": "MidiFilePlayer",
      "params": {
        "file": "../../assets/midi/midi_file_player_demo.mid",
        "playing": true,
        "loop": true,
        "transpose": -12,
        "velocity_scale": 0.85
      }
    },
    "synth1": {
      "type": "WavetableSynth",
      "params": {
        "wavetable": 6.0,
        "position": 0.62,
        "warp_mode": 2.0,
        "warp_amount": 0.1,
        "unison_voices": 3.0,
        "unison_spread": 10.0,
        "unison_stereo": 0.55,
        "sub_level": 0.08,
        "amplitude": 0.18,
        "attack": 0.08,
        "decay": 0.45,
        "sustain": 0.72,
        "release": 0.55,
        "filter_type": 0.0,
        "filter_cutoff": 2200.0,
        "filter_resonance": 0.18,
        "filter_env_amount": 0.22,
        "position_env_amount": 0.18
      }
    },
    "out1": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    { "from": "midi1/notes_out", "to": "synth1/notes_in" },
    { "from": "synth1/output", "to": "out1/input" }
  ]
}
