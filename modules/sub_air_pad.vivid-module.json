{
  "schema_version": 3,
  "module": {
    "name": "SubAirPad",
    "description": "Broad pad voice that combines a wavetable body, supportive sub layer, and airy noise detail behind one compact instrument surface with dual-stage body filtering.",
    "category": "Instrument",
    "ports": [
      { "name": "notes", "type": "lane_array", "direction": "input", "bind": "voices/notes_in" },
      { "name": "velocities", "type": "lane_array", "direction": "input", "bind": "voices/velocities_in" },
      { "name": "gates", "type": "lane_array", "direction": "input", "bind": "voices/gates_in" },
      { "name": "output", "type": "audio", "direction": "output", "bind": "out_gain/output" }
    ],
    "params": [
      {
        "name": "wavetable_family",
        "bind": "wt/wavetable_family",
        "group": "Osc A",
        "default": 0,
        "choices": ["AnalogWarm", "BrightDigital", "VocalFormant", "Metallic", "HarmonicSpectral", "TextureMotion"],
        "description": "Main body wavetable family."
      },
      {
        "name": "wavetable_member",
        "bind": "wt/wavetable_member",
        "group": "Osc A",
        "default": 1,
        "choices": ["Core", "Soft", "Rich", "Hollow", "Sweep", "Glass", "Edge", "Air"],
        "description": "Main body wavetable member."
      },
      {
        "name": "wavetable_position",
        "bind": "wt/position",
        "group": "Osc A",
        "default": 0.34,
        "min": 0.0,
        "max": 1.0,
        "description": "Main body wavetable scan position."
      },
      {
        "name": "wavetable_source",
        "bind": "wt/wavetable_source",
        "group": "Osc A",
        "default": 0,
        "choices": ["Builtin", "Custom"],
        "description": "Main body wavetable source mode: builtin bank or custom wav file."
      },
      {
        "name": "wavetable_file",
        "bind": "wt/wav_file",
        "group": "Osc A",
        "default": "",
        "description": "Path to a custom main body wavetable wav file."
      },
      {
        "name": "sub_level",
        "bind": "sub/level",
        "group": "Layer",
        "default": 0.22,
        "min": 0.0,
        "max": 1.0,
        "description": "Low support layer level."
      },
      {
        "name": "air_level",
        "bind": "air/level",
        "group": "Layer",
        "default": 0.08,
        "min": 0.0,
        "max": 1.0,
        "performance_page": "Performance",
        "performance_order": 0,
        "performance_role": "macro",
        "description": "Air/noise layer level."
      },
      {
        "name": "filter_tone",
        "bind": "dual_filter/a_cutoff",
        "group": "Tone",
        "default": 2100.0,
        "min": 20.0,
        "max": 20000.0,
        "performance_page": "Timbre",
        "performance_order": 0,
        "performance_role": "expression",
        "description": "Main tone control for the wavetable body."
      },
      {
        "name": "body",
        "bind": "drive/drive",
        "group": "Character",
        "default": 0.16,
        "min": 0.0,
        "max": 1.0,
        "performance_page": "Performance",
        "performance_order": 1,
        "performance_role": "macro",
        "description": "Per-voice body/glue on the main layer."
      },
      {
        "name": "output_level",
        "bind": "out_gain/gain",
        "group": "Output",
        "default": 0.9,
        "min": 0.0,
        "max": 2.0,
        "description": "Final module output level."
      }
    ],
    "mod_destinations": [
      {
        "name": "air",
        "description": "Air/noise layer level",
        "bind": "air/level",
        "group": "Layer"
      },
      {
        "name": "brightness",
        "description": "Filter cutoff",
        "bind": "dual_filter/a_cutoff",
        "group": "Tone"
      },
      {
        "name": "body",
        "description": "Drive amount",
        "bind": "drive/drive",
        "group": "Character"
      }
    ]
  },
  "nodes": {
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "max_voices": 8,
        "portamento": 24.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.08,
        "decay": 0.75,
        "sustain": 0.82,
        "release": 1.45
      }
    },
    "wt": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "position": 0.34,
        "amplitude": 0.2,
        "unison_voices": 3,
        "unison_spread": 10.0,
        "unison_stereo": 0.56,
        "unison_output_mode": 1,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 1
      }
    },
    "sub": {
      "type": "SubOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "waveform": 1,
        "level": 0.22,
        "velocity_to_level": 0.1
      }
    },
    "air": {
      "type": "NoiseLayer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "color": 0.68,
        "level": 0.08,
        "tone": 0.72,
        "tone_tracking": 0.18,
        "velocity_to_level": 0.2
      }
    },
    "dual_filter": {
      "type": "DualFilter",
      "params": {
        "routing": 2,
        "parallel_balance": 0.82,
        "a_mode": 1,
        "a_cutoff": 2100.0,
        "a_resonance": 0.1,
        "a_drive": 0.04,
        "a_keytrack": 0.3,
        "b_mode": 3,
        "b_cutoff": 4200.0,
        "b_resonance": 0.14,
        "b_drive": 0.0,
        "b_keytrack": 0.2,
        "output_gain": 1.0
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "drive": 0.16,
        "tone": 0.48,
        "mix": 0.34,
        "output_level": 1.0
      }
    },
    "mix_wt": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "input_layout": 1,
        "stereo_spread": 0.62,
        "vel_to_volume": 1.0,
        "glue": 0.05
      }
    },
    "mix_sub": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.18,
        "vel_to_volume": 1.0,
        "glue": 0.02
      }
    },
    "mix_air": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "input_layout": 0,
        "stereo_spread": 0.84,
        "vel_to_volume": 0.7,
        "glue": 0.02
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.72,
        "gain_3": 0.55
      }
    },
    "out_gain": {
      "type": "Gain",
      "params": {
        "gain": 0.9
      }
    }
  },
  "connections": [
    { "from": "voices/gates", "to": "amp_env/gate" },
    { "from": "voices/frequencies", "to": "wt/frequencies" },
    { "from": "voices/gates", "to": "wt/gates" },
    { "from": "voices/velocities", "to": "wt/velocities" },
    { "from": "voices/lane_ids", "to": "wt/lane_ids" },
    { "from": "voices/frequencies", "to": "sub/frequencies" },
    { "from": "voices/gates", "to": "sub/gates" },
    { "from": "voices/velocities", "to": "sub/velocities" },
    { "from": "voices/lane_ids", "to": "sub/lane_ids" },
    { "from": "voices/frequencies", "to": "air/frequencies" },
    { "from": "voices/gates", "to": "air/gates" },
    { "from": "voices/velocities", "to": "air/velocities" },
    { "from": "voices/lane_ids", "to": "air/lane_ids" },
    { "from": "wt/output", "to": "dual_filter/input" },
    { "from": "voices/frequencies", "to": "dual_filter/frequencies" },
    { "from": "dual_filter/output", "to": "drive/input" },
    { "from": "voices/velocities", "to": "drive/velocities" },
    { "from": "drive/output", "to": "mix_wt/input" },
    { "from": "sub/output", "to": "mix_sub/input" },
    { "from": "air/output", "to": "mix_air/input" },
    { "from": "amp_env/value", "to": "mix_wt/amp_env_audio" },
    { "from": "amp_env/value", "to": "mix_sub/amp_env_audio" },
    { "from": "amp_env/value", "to": "mix_air/amp_env_audio" },
    { "from": "voices/velocities", "to": "mix_wt/velocities" },
    { "from": "voices/velocities", "to": "mix_sub/velocities" },
    { "from": "voices/velocities", "to": "mix_air/velocities" },
    { "from": "mix_wt/output", "to": "sum/input_1" },
    { "from": "mix_sub/output", "to": "sum/input_2" },
    { "from": "mix_air/output", "to": "sum/input_3" },
    { "from": "sum/output", "to": "out_gain/input" }
  ]
}
