{
  "schema_version": 3,
  "module": {
    "name": "GlassInteractionKeys",
    "description": "Glassy interaction-led keys voice with an analog modulator driving a wavetable carrier through the Pass 4 interaction surface.",
    "category": "Instrument",
    "ports": [
      { "name": "notes", "type": "lane_array", "direction": "input", "bind": "voices/notes_in" },
      { "name": "velocities", "type": "lane_array", "direction": "input", "bind": "voices/velocities_in" },
      { "name": "gates", "type": "lane_array", "direction": "input", "bind": "voices/gates_in" },
      { "name": "output", "type": "audio", "direction": "output", "bind": "out_gain/output" },
      { "name": "aftertouch", "type": "signal", "direction": "input", "bind": "expr_cv/a" },
      { "name": "expression", "type": "signal", "direction": "input", "bind": "expr_cv/b" }
    ],
    "params": [
      {
        "name": "wavetable_family",
        "bind": "carrier/wavetable_family",
        "group": "Osc A",
        "default": 1,
        "choices": ["AnalogWarm", "BrightDigital", "VocalFormant", "Metallic", "HarmonicSpectral", "TextureMotion"],
        "description": "Carrier wavetable family."
      },
      {
        "name": "wavetable_member",
        "bind": "carrier/wavetable_member",
        "group": "Osc A",
        "default": 5,
        "choices": ["Core", "Soft", "Rich", "Hollow", "Sweep", "Glass", "Edge", "Air"],
        "description": "Carrier wavetable member."
      },
      {
        "name": "wavetable_position",
        "bind": "carrier/position",
        "group": "Osc A",
        "default": 0.22,
        "min": 0.0,
        "max": 1.0,
        "description": "Carrier wavetable scan position."
      },
      {
        "name": "wavetable_source",
        "bind": "carrier/wavetable_source",
        "group": "Osc A",
        "default": 0,
        "choices": ["Builtin", "Custom"],
        "description": "Carrier wavetable source mode: builtin bank or custom wav file."
      },
      {
        "name": "wavetable_file",
        "bind": "carrier/wav_file",
        "group": "Osc A",
        "default": "",
        "description": "Path to a custom carrier wavetable wav file."
      },
      {
        "name": "modulator_amount",
        "bind": "modulator/amplitude",
        "group": "Layer",
        "default": 0.52,
        "min": 0.0,
        "max": 1.0,
        "performance_page": "Performance",
        "performance_order": 1,
        "performance_role": "macro",
        "description": "Analog modulator level feeding the carrier interaction input."
      },
      {
        "name": "interaction_depth",
        "bind": "carrier/interaction_depth",
        "group": "Motion",
        "default": 0.42,
        "min": 0.0,
        "max": 1.0,
        "performance_page": "Performance",
        "performance_order": 0,
        "performance_role": "macro",
        "description": "Depth of the carrier interaction response."
      },
      {
        "name": "filter_cutoff",
        "bind": "filter/cutoff",
        "group": "Tone",
        "default": 4200.0,
        "min": 20.0,
        "max": 20000.0,
        "performance_page": "Timbre",
        "performance_order": 0,
        "performance_role": "expression",
        "description": "Main brightness control."
      },
      {
        "name": "filter_resonance",
        "bind": "filter/resonance",
        "group": "Tone",
        "default": 0.14,
        "min": 0.0,
        "max": 1.0,
        "description": "Filter resonance."
      },
      {
        "name": "drive",
        "bind": "drive/drive",
        "group": "Character",
        "default": 0.14,
        "min": 0.0,
        "max": 1.0,
        "description": "Per-voice drive amount."
      },
      {
        "name": "body",
        "bind": "drive/tone",
        "group": "Character",
        "default": 0.64,
        "min": 0.0,
        "max": 1.0,
        "performance_page": "Timbre",
        "performance_order": 1,
        "performance_role": "expression",
        "description": "Drive tone/body balance."
      },
      {
        "name": "output_level",
        "bind": "out_gain/gain",
        "group": "Output",
        "default": 0.92,
        "min": 0.0,
        "max": 2.0,
        "description": "Final module output level."
      }
    ],
    "mod_sources": [
      {
        "name": "aftertouch",
        "description": "Channel aftertouch",
        "bind": "aftertouch",
        "kind": "port",
        "polarity": "unipolar"
      },
      {
        "name": "expression",
        "description": "MIDI expression",
        "bind": "expression",
        "kind": "port",
        "polarity": "unipolar"
      }
    ],
    "mod_destinations": [
      {
        "name": "interaction",
        "description": "Carrier interaction depth",
        "bind": "carrier/interaction_depth",
        "group": "Motion"
      },
      {
        "name": "brightness",
        "description": "Filter cutoff",
        "bind": "filter/cutoff",
        "group": "Tone"
      },
      {
        "name": "body",
        "description": "Drive tone/body",
        "bind": "drive/tone",
        "group": "Character"
      }
    ]
  },
  "nodes": {
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "max_voices": 8,
        "portamento": 18.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.004,
        "decay": 0.9,
        "sustain": 0.46,
        "release": 0.85
      }
    },
    "filt_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.003,
        "decay": 0.42,
        "sustain": 0.18,
        "release": 0.35
      }
    },
    "modulator": {
      "type": "AnalogOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "waveform": 0,
        "amplitude": 0.52
      }
    },
    "carrier": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "position": 0.22,
        "amplitude": 0.24,
        "unison_voices": 2,
        "unison_spread": 8.0,
        "unison_stereo": 0.32,
        "phase_reset_mode": 1,
        "start_phase": 0.05,
        "interaction_mode": 2,
        "interaction_depth": 0.42,
        "interaction_input_gain": 1.35,
        "interaction_tracking": 1.0,
        "wavetable_source": 0,
        "wavetable_family": 1,
        "wavetable_member": 5
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 1,
        "cutoff": 4200.0,
        "resonance": 0.14,
        "keytrack": 0.7
      }
    },
    "drive": {
      "type": "VoiceDrive",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "drive": 0.14,
        "tone": 0.64,
        "mix": 0.52,
        "output_level": 1.0,
        "velocity_to_drive": 0.2
      }
    },
    "mixer": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "stereo_spread": 0.36,
        "vel_to_volume": 1.0,
        "glue": 0.08
      }
    },
    "expr_cv": {
      "type": "Math",
      "params": {
        "operation": 0
      }
    },
    "out_gain": {
      "type": "Gain",
      "params": {
        "gain": 0.92
      }
    }
  },
  "connections": [
    { "from": "voices/gates", "to": "amp_env/gate" },
    { "from": "voices/gates", "to": "filt_env/gate" },
    { "from": "voices/frequencies", "to": "modulator/frequencies" },
    { "from": "voices/gates", "to": "modulator/gates" },
    { "from": "voices/velocities", "to": "modulator/velocities" },
    { "from": "voices/lane_ids", "to": "modulator/lane_ids" },
    { "from": "voices/frequencies", "to": "carrier/frequencies" },
    { "from": "voices/gates", "to": "carrier/gates" },
    { "from": "voices/velocities", "to": "carrier/velocities" },
    { "from": "voices/lane_ids", "to": "carrier/lane_ids" },
    { "from": "modulator/output", "to": "carrier/mod_input" },
    { "from": "carrier/output", "to": "filter/input" },
    { "from": "voices/frequencies", "to": "filter/frequencies" },
    { "from": "filt_env/value", "to": "filter/cutoff_mod" },
    { "from": "filter/output", "to": "drive/input" },
    { "from": "voices/velocities", "to": "drive/velocities" },
    { "from": "drive/output", "to": "mixer/input" },
    { "from": "amp_env/value", "to": "mixer/amp_env_audio" },
    { "from": "voices/velocities", "to": "mixer/velocities" },
    { "from": "mixer/output", "to": "out_gain/input" }
  ]
}
