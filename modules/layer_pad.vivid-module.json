{
  "schema_version": 1,
  "module": {
    "name": "LayerPad",
    "description": "Production pad voice built on WavetableLayer with internal unison, stereo summing, and LFO-driven wavetable motion. No VoiceMixer required.",
    "category": "Instrument",
    "ports": [
      {
        "name": "notes_in",
        "type": "custom_ref",
        "data_type": "VividNoteBuffer",
        "direction": "input",
        "bind": "voice_breakout/notes_in"
      },
      {
        "name": "output",
        "type": "audio",
        "direction": "output",
        "bind": "out_gain/output"
      }
    ],
    "params": [
      {
        "name": "wavetable_family",
        "bind": "wt/wavetable_family",
        "group": "Oscillator",
        "default": 2,
        "choices": [
          "AnalogWarm",
          "BrightDigital",
          "VocalFormant",
          "Metallic",
          "HarmonicSpectral",
          "TextureMotion"
        ],
        "description": "Wavetable family."
      },
      {
        "name": "wavetable_member",
        "bind": "wt/wavetable_member",
        "group": "Oscillator",
        "default": 2,
        "choices": [
          "Core",
          "Soft",
          "Rich",
          "Hollow",
          "Sweep",
          "Glass",
          "Edge",
          "Air"
        ],
        "description": "Wavetable member within the selected family."
      },
      {
        "name": "wavetable_position",
        "bind": "wt/position",
        "group": "Oscillator",
        "default": 0.35,
        "min": 0.0,
        "max": 1.0,
        "description": "Wavetable scan position. Controls the base timbre."
      },
      {
        "name": "wavetable_source",
        "bind": "wt/wavetable_source",
        "group": "Oscillator",
        "default": 0,
        "choices": [
          "Builtin",
          "Custom"
        ],
        "description": "Wavetable source: builtin bank or custom wav file."
      },
      {
        "name": "wavetable_file",
        "bind": "wt/wav_file",
        "group": "Oscillator",
        "default": "",
        "description": "Path to a custom wavetable wav file."
      },
      {
        "name": "motion_amount",
        "bind": "motion/amplitude",
        "group": "Motion",
        "default": 0.12,
        "min": 0.0,
        "max": 0.5,
        "performance_page": "Performance",
        "performance_role": "motion",
        "description": "LFO-driven wavetable motion depth."
      },
      {
        "name": "motion_rate",
        "bind": "motion/frequency",
        "group": "Motion",
        "default": 0.08,
        "min": 0.01,
        "max": 2.0,
        "description": "Motion LFO rate in Hz."
      },
      {
        "name": "warp_mode",
        "bind": "wt/warp_mode",
        "group": "Warp",
        "default": 0,
        "choices": [
          "None",
          "Sync",
          "BendPlus",
          "BendMinus",
          "Mirror",
          "Asym",
          "Quantize",
          "Flip"
        ],
        "description": "Waveform warp mode."
      },
      {
        "name": "warp_amount",
        "bind": "wt/warp_amount",
        "group": "Warp",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "Warp intensity."
      },
      {
        "name": "unison_voices",
        "bind": "wt/unison_voices",
        "group": "Character",
        "default": 4,
        "min": 1,
        "max": 16,
        "description": "Number of unison sub-voices per note."
      },
      {
        "name": "unison_spread",
        "bind": "wt/unison_spread",
        "group": "Character",
        "default": 16.0,
        "min": 0.0,
        "max": 100.0,
        "description": "Unison detune spread in cents."
      },
      {
        "name": "output_level",
        "bind": "out_gain/gain",
        "group": "Output",
        "default": 0.85,
        "min": 0.0,
        "max": 2.0,
        "description": "Final module output level."
      }
    ],
    "mod_sources": [
      {
        "name": "motion_lfo",
        "description": "Internal motion LFO output.",
        "bind": "motion/value",
        "polarity": "bipolar",
        "shape": "scalar",
        "kind": "internal",
        "group": "Motion"
      }
    ],
    "mod_destinations": [
      {
        "name": "motion",
        "description": "Motion depth.",
        "bind": "motion/amplitude",
        "group": "Motion"
      },
      {
        "name": "warp",
        "description": "Warp intensity.",
        "bind": "wt/warp_amount",
        "group": "Warp"
      }
    ]
  },
  "nodes": {
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.15,
        "decay": 0.7,
        "sustain": 0.78,
        "release": 1.6
      }
    },
    "motion": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.08,
        "amplitude": 0.12,
        "waveform": 0
      }
    },
    "wt": {
      "type": "WavetableLayer",
      "pkg": {
        "name": "vivid-wavetable"
      },
      "params": {
        "position": 0.35,
        "amplitude": 0.22,
        "unison_voices": 4,
        "unison_spread": 16.0,
        "unison_stereo": 0.78,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 2
      }
    },
    "out_gain": {
      "type": "Gain",
      "params": {
        "gain": 0.85
      }
    },
    "voice_breakout": {
      "type": "NoteBreakout"
    }
  },
  "connections": [
    {
      "from": "amp_env/value",
      "to": "wt/voice_gain_audio"
    },
    {
      "from": "motion/value",
      "to": "wt/position_mod_audio"
    },
    {
      "from": "wt/output",
      "to": "out_gain/input"
    },
    {
      "from": "voice_breakout/notes_out",
      "to": "wt/notes_in"
    },
    {
      "from": "voice_breakout/voice_gates",
      "to": "amp_env/gate"
    },
    {
      "from": "voice_breakout/voice_ids",
      "to": "amp_env/lane_ids"
    }
  ]
}
