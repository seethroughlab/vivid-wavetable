{
  "schema_version": 3,
  "module": {
    "name": "DualWavetablePad",
    "description": "Layered dual-wavetable pad voice with shared motion, a main tone filter, and a compact blend-oriented surface.",
    "category": "Instrument",
    "ports": [
      { "name": "notes", "type": "lane_array", "direction": "input", "bind": "voices/notes_in" },
      { "name": "velocities", "type": "lane_array", "direction": "input", "bind": "voices/velocities_in" },
      { "name": "gates", "type": "lane_array", "direction": "input", "bind": "voices/gates_in" },
      { "name": "output", "type": "audio", "direction": "output", "bind": "out_gain/output" }
    ],
    "params": [
      {
        "name": "osc_a_family",
        "bind": "osc_a/wavetable_family",
        "group": "Osc A",
        "default": 2,
        "choices": ["AnalogWarm", "BrightDigital", "VocalFormant", "Metallic", "HarmonicSpectral", "TextureMotion"],
        "description": "Primary pad wavetable family."
      },
      {
        "name": "osc_a_member",
        "bind": "osc_a/wavetable_member",
        "group": "Osc A",
        "default": 4,
        "choices": ["Core", "Soft", "Rich", "Hollow", "Sweep", "Glass", "Edge", "Air"],
        "description": "Primary pad wavetable member."
      },
      {
        "name": "osc_a_position",
        "bind": "osc_a/position",
        "group": "Osc A",
        "default": 0.34,
        "min": 0.0,
        "max": 1.0,
        "description": "Primary layer scan position."
      },
      {
        "name": "osc_b_family",
        "bind": "osc_b/wavetable_family",
        "group": "Osc B",
        "default": 0,
        "choices": ["AnalogWarm", "BrightDigital", "VocalFormant", "Metallic", "HarmonicSpectral", "TextureMotion"],
        "description": "Secondary pad wavetable family."
      },
      {
        "name": "osc_b_member",
        "bind": "osc_b/wavetable_member",
        "group": "Osc B",
        "default": 2,
        "choices": ["Core", "Soft", "Rich", "Hollow", "Sweep", "Glass", "Edge", "Air"],
        "description": "Secondary pad wavetable member."
      },
      {
        "name": "osc_b_position",
        "bind": "osc_b/position",
        "group": "Osc B",
        "default": 0.18,
        "min": 0.0,
        "max": 1.0,
        "description": "Secondary layer scan position."
      },
      {
        "name": "blend",
        "bind": "sum/gain_2",
        "group": "Layer",
        "default": 0.82,
        "min": 0.0,
        "max": 1.5,
        "description": "Level of the second wavetable layer."
      },
      {
        "name": "motion_amount",
        "bind": "motion/amplitude",
        "group": "Motion",
        "default": 0.1,
        "min": 0.0,
        "max": 0.5,
        "description": "Shared motion depth feeding both wavetable layers."
      },
      {
        "name": "filter_tone",
        "bind": "filter/cutoff",
        "group": "Tone",
        "default": 2800.0,
        "min": 20.0,
        "max": 20000.0,
        "description": "Main pad brightness control."
      },
      {
        "name": "width",
        "bind": "mix_a/stereo_spread",
        "group": "Character",
        "default": 0.86,
        "min": 0.0,
        "max": 1.0,
        "description": "Stereo width of the primary pad layer."
      },
      {
        "name": "unison_spread",
        "bind": "osc_a/unison_spread",
        "group": "Character",
        "default": 18.0,
        "min": 0.0,
        "max": 40.0,
        "description": "Primary layer unison spread."
      },
      {
        "name": "output_level",
        "bind": "out_gain/gain",
        "group": "Output",
        "default": 0.88,
        "min": 0.0,
        "max": 2.0,
        "description": "Final module output level."
      }
    ]
  },
  "nodes": {
    "voices": {
      "type": "PolyVoiceAllocator",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "max_voices": 8,
        "portamento": 28.0
      }
    },
    "amp_env": {
      "type": "EnvelopeAu",
      "params": {
        "attack": 0.18,
        "decay": 0.8,
        "sustain": 0.76,
        "release": 1.8
      }
    },
    "motion": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.065,
        "amplitude": 0.1,
        "offset": 0.0,
        "waveform": 0,
        "rate_mode": 0,
        "polarity": 0,
        "phase_offset": 0.0,
        "fade_in": 0.0,
        "slew": 0.0,
        "distribution": 0,
        "seed": 0
      }
    },
    "osc_a": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "position": 0.34,
        "amplitude": 0.18,
        "unison_voices": 4,
        "unison_spread": 18.0,
        "unison_stereo": 0.82,
        "unison_output_mode": 1,
        "wavetable_source": 0,
        "wavetable_family": 2,
        "wavetable_member": 4
      }
    },
    "osc_b": {
      "type": "WavetableOsc",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "position": 0.18,
        "amplitude": 0.16,
        "unison_voices": 3,
        "unison_spread": 11.0,
        "unison_stereo": 0.64,
        "unison_output_mode": 1,
        "wavetable_source": 0,
        "wavetable_family": 0,
        "wavetable_member": 2
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "mode": 0,
        "cutoff": 2800.0,
        "resonance": 0.12,
        "drive": 0.04,
        "keytrack": 0.35
      }
    },
    "mix_a": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "input_layout": 1,
        "stereo_spread": 0.86,
        "vel_to_volume": 1.0,
        "glue": 0.06
      }
    },
    "mix_b": {
      "type": "VoiceMixer",
      "pkg": { "name": "vivid-wavetable" },
      "params": {
        "input_layout": 1,
        "stereo_spread": 0.72,
        "vel_to_volume": 1.0,
        "glue": 0.04
      }
    },
    "sum": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.82
      }
    },
    "out_gain": {
      "type": "Gain",
      "params": {
        "gain": 0.88
      }
    }
  },
  "connections": [
    { "from": "voices/gates", "to": "amp_env/gate" },
    { "from": "voices/frequencies", "to": "osc_a/frequencies" },
    { "from": "voices/gates", "to": "osc_a/gates" },
    { "from": "voices/velocities", "to": "osc_a/velocities" },
    { "from": "voices/lane_ids", "to": "osc_a/lane_ids" },
    { "from": "voices/frequencies", "to": "osc_b/frequencies" },
    { "from": "voices/gates", "to": "osc_b/gates" },
    { "from": "voices/velocities", "to": "osc_b/velocities" },
    { "from": "voices/lane_ids", "to": "osc_b/lane_ids" },
    { "from": "motion/output", "to": "osc_a/position_mod_audio" },
    { "from": "motion/output", "to": "osc_b/position_mod_audio" },
    { "from": "osc_a/output", "to": "filter/input" },
    { "from": "voices/frequencies", "to": "filter/frequencies" },
    { "from": "filter/output", "to": "mix_a/input" },
    { "from": "osc_b/output", "to": "mix_b/input" },
    { "from": "amp_env/value", "to": "mix_a/amp_env_audio" },
    { "from": "amp_env/value", "to": "mix_b/amp_env_audio" },
    { "from": "voices/velocities", "to": "mix_a/velocities" },
    { "from": "voices/velocities", "to": "mix_b/velocities" },
    { "from": "mix_a/output", "to": "sum/input_1" },
    { "from": "mix_b/output", "to": "sum/input_2" },
    { "from": "sum/output", "to": "out_gain/input" }
  ]
}
